local function startRitual()
    if ST.running then
        setStatusSafe("испытание уже идёт", true)
        return
    end
    ST.running = true
    ST.monsterRage = 0
    ST.rageStart = os.clock()
    ST.monsterHP = 6
    ST.monsterHits = 0
    ST.monsterStagger = 0
    ST.nextSummon = 0
    ST.monsterAware = false
    ST.waveActive = false
    ST.waveStartDelay = 0
    ST.waveKills = 0
    INV.shells = 0
    INV.adrenaline = 0
    INV.crowbar = false
    INV.loaded = { false, false }
    if crowbarTool then crowbarTool:Destroy() crowbarTool = nil end
    setStatusSafe("ИСПЫТАНИЕ НАЧАЛОСЬ · выхода нет", true)
    task.spawn(function()
        doCountdown()
        if not ST.running then return end
        local r = root()
        if not r then stopRitualSafe(true) return end

        local angle = math.rad(math.random(0, 359))
        local spawnPos = r.Position + Vector3.new(math.cos(angle) * 100, 0, math.sin(angle) * 100)
        spawnPos = Vector3.new(spawnPos.X, groundAt(spawnPos, r.Position.Y), spawnPos.Z)

        local built, eyes = buildMonster()
        ST.monster = built
        monsterEyes = eyes
        ST.monsterPos = spawnPos

        setBloodFog(true)
        spawnShotgun()
        spawnLootBoxes()
        ST.ambientSnd = playId(SOUNDS.ambient, 0.4, true)
        ST.voicesSnd = playId(SOUNDS.voices, 0, true, 0.85)
        ST.staticSnd = playId(SOUNDS.static, 0, true)

        setStatusSafe("ПРОЛОГ: они уже рядом · ищи дробовик, лом и патроны", true)
        ST.nextScare = os.clock() + 8
        ST.nextFar = os.clock() + math.random(4, 8)
        ST.nextBehind = os.clock() + math.random(35, 70)
        ST.nextFlicker = os.clock() + math.random(20, 50)

        ST.radarOpen = true
        UI.radarFrame.Visible = true
        refreshInvUI()

        task.delay(math.random(8, 15), function()
            if not ST.running then return end
            local rr = root()
            if not rr then return end
            local a = math.rad(math.random(0, 359))
            ST.watcher = buildWatcher(rr.Position + Vector3.new(math.cos(a) * 55, 0, math.sin(a) * 55))
            ST.watcherAlive = true
        end)

        task.delay(2, function()
            if not ST.running then return end
            local rr = root()
            if not rr then return end
            local lv = rr.CFrame.LookVector
            local p = rr.Position + Vector3.new(-lv.X, 0, -lv.Z) * 25
            p = Vector3.new(p.X, groundAt(p, rr.Position.Y), p.Z)
            ST.stalker = buildStalker(p)
            ST.stalkerPos = p
            ST.stalkerState = "follow"
            ST.stalkerTimer = os.clock() + math.random(14, 20)
            ST.stalkerLookTime = 0
            ST.stalkerWalkPhase = 0
            setStatusSafe("кто-то идёт за тобой...", true)
        end)
        task.delay(6, function()
            if not ST.running then return end
            local rr = root()
            if not rr then return end
            local a = math.rad(math.random(0, 359))
            local p = rr.Position + Vector3.new(math.cos(a) * 35, 0, math.sin(a) * 35)
            p = Vector3.new(p.X, groundAt(p, rr.Position.Y), p.Z)
            ST.crawler = buildCrawler(p)
            ST.crawlerPos = p
            ST.crawlerState = "prowl"
            ST.crawlerWalkPhase = 0
            setStatusSafe("шорох с фланга...", true)
        end)
    end)
end

