local liveSounds = {}
local function playId(list, volume, looped, pitch)
    for _, id in ipairs(list) do
        local s = Instance.new("Sound")
        s.SoundId = "rbxassetid://" .. tostring(id)
        s.Volume = 0
        s.Looped = looped or false
        if pitch then s.PlaybackSpeed = pitch end
        s.Parent = workspace
        s:Play()
        local t0 = os.clock()
        while not s.IsLoaded and os.clock() - t0 < 2.5 do task.wait(0.05) end
        if s.IsLoaded then
            s.Volume = volume or 0.5
            table.insert(liveSounds, s)
            return s
        end
        s:Destroy()
    end
    return nil
end
local function stopAllSounds()
    for _, s in ipairs(liveSounds) do pcall(function() s:Destroy() end) end
    table.clear(liveSounds)
end

