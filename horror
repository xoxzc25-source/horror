---------------------------------------------------------------- ЗВУКИ (автоочистка + кап)
local liveSounds = {}
local activeSounds = 0

local function cleanupSounds()
    for i = #liveSounds, 1, -1 do
        local s = liveSounds[i]
        if not s or not s.Parent or (not s.Looped and not s.IsPlaying) then
            if s and s.Parent then s:Destroy() end
            table.remove(liveSounds, i)
            activeSounds = math.max(0, activeSounds - 1)
        end
    end
end

local function playId(list, volume, looped, pitch)
    cleanupSounds()
    while activeSounds >= CFG.MAX_SOUNDS do
        local removed = false
        for i = 1, #liveSounds do
            local s = liveSounds[i]
            if s and s.Parent and not s.Looped then
                s:Destroy()
                table.remove(liveSounds, i)
                activeSounds = math.max(0, activeSounds - 1)
                removed = true
                break
            end
        end
        if not removed then break end
    end
    for _, id in ipairs(list) do
        local s = Instance.new("Sound")
        s.SoundId = "rbxassetid://" .. tostring(id)
        s.Volume = 0
        s.Looped = looped or false
        if pitch then s.PlaybackSpeed = pitch end
        s.Parent = workspace
        s:Play()
        local t0 = os.clock()
        while not s.IsLoaded and os.clock() - t0 < 2.5 do task.wait(0.05) end
        if s.IsLoaded then
            s.Volume = volume or 0.5
            table.insert(liveSounds, s)
            activeSounds += 1
            return s
        end
        s:Destroy()
    end
    return nil
end

local function stopAllSounds()
    for _, s in ipairs(liveSounds) do pcall(function() s:Destroy() end) end
    table.clear(liveSounds)
    activeSounds = 0
end

