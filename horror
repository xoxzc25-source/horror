local radarOpen = false
local lastShotgunPing = 0
local shotgunWorldPos = nil
local lastPingBlink = 0
local lootBoxes = {}
local nearestLoot = nil

local function distTo(pos)
    local r = root()
    if not (r and pos) then return nil end
    local flat = r.Position - pos
    return math.floor(Vector3.new(flat.X, 0, flat.Z).Magnitude)
end

local function updateRadar(now)
    if not radarOpen then return end
    if now - lastShotgunPing >= 5 then
        lastShotgunPing = now
        lastPingBlink = now
    end
    local blink = (now - lastPingBlink) < 0.6

    local haveGun = gunTool ~= nil or INV.loaded[1] or INV.loaded[2] or INV.shells > 0
    local d = distTo(shotgunWorldPos)
    if d and not haveGun then
        radarRows.shotgun.Text = (blink and "▸ " or "") .. d .. " ст"
        radarRows.shotgun.Visible = true
    elseif haveGun then
        radarRows.shotgun.Text = "у тебя"
        radarRows.shotgun.Visible = true
    else
        radarRows.shotgun.Visible = false
    end

    nearestLoot = nil
    local minLD = math.huge
    for _, lb in ipairs(lootBoxes) do
        if lb.model and lb.model.Parent then
            local ld = distTo(lb.pos)
            if ld and ld < minLD then minLD = ld nearestLoot = ld end
        end
    end
    if nearestLoot then
        radarRows.loot.Text = nearestLoot .. " ст"
        radarRows.loot.Visible = true
    else
        radarRows.loot.Visible = false
    end

    d = distTo(monsterPos)
    radarRows.monster.Visible = (d ~= nil and monster ~= nil)
    if d and monster then radarRows.monster.Text = d .. " ст" end
    d = distTo(brutePos)
    radarRows.brute.Visible = (d ~= nil and brute ~= nil)
    if d and brute then radarRows.brute.Text = d .. " ст(" .. bruteHP .. ")" end
    d = distTo(stalkerPos)
    radarRows.stalker.Visible = (d ~= nil and stalkerState ~= "none")
    if d and stalkerState ~= "none" then radarRows.stalker.Text = d .. " ст" end
    d = distTo(crawlerPos)
    radarRows.crawler.Visible = (d ~= nil and crawlerState == "prowl")
    if d and crawlerState == "prowl" then radarRows.crawler.Text = d .. " ст" end
    d = distTo(motherPos)
    radarRows.mother.Visible = (d ~= nil and mother ~= nil)
    if d and mother then radarRows.mother.Text = d .. " ст" end
    if waveActive then
        radarRows.wave.Text = waveNearest and (waveNearest .. " ст") or "..."
        radarRows.wave.Visible = true
        radarHint.Text = "ВОЛНА: убей всех!"
        radarHint.TextColor3 = C.blood
    else
        radarRows.wave.Visible = false
        radarHint.Text = ""
    end
end

