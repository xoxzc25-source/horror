local fxGui = New("ScreenGui", {
    Name = "NF_FX", ResetOnSpawn = false, IgnoreGuiInset = true,
    DisplayOrder = 240, Parent = playerGui,
})
local STATIC_ROWS, STATIC_COLS = 12, 9
local staticHolder = New("Frame", {
    BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = fxGui,
})
local staticCells = {}
for r = 1, STATIC_ROWS do
    staticCells[r] = {}
    for c = 1, STATIC_COLS do
        local cell = New("Frame", {
            BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1,
            Size = UDim2.new(1 / STATIC_COLS, 0, 1 / STATIC_ROWS, 0),
            Position = UDim2.new((c - 1) / STATIC_COLS, 0, (r - 1) / STATIC_ROWS, 0),
            Parent = staticHolder,
        })
        staticCells[r][c] = cell
    end
end
local function setStaticIntensity(intensity)
    staticHolder.Visible = intensity > 0.02
    if not staticHolder.Visible then return end
    for r = 1, STATIC_ROWS do
        for c = 1, STATIC_COLS do
            local cell = staticCells[r][c]
            if math.random() < intensity * 0.45 then
                cell.BackgroundTransparency = 1 - math.random() * 0.75
                cell.BackgroundColor3 = math.random() > 0.5
                    and Color3.new(1, 1, 1) or Color3.new(0.05, 0.05, 0.05)
            else
                cell.BackgroundTransparency = 1
            end
        end
    end
end

