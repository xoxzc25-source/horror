local function refreshReloadUI()
    UI.ch1Label.TextTransparency = INV.loaded[1] and 1 or 0
    UI.ch2Label.TextTransparency = INV.loaded[2] and 1 or 0
    UI.shellIcon1.Visible = INV.loaded[1]
    UI.shellIcon2.Visible = INV.loaded[2]
    UI.shellSrcCount.Text = "×" .. INV.shells
end

local function insertShell(chamber)
    if INV.shells <= 0 then return false end
    if chamber == 1 and not INV.loaded[1] then
        INV.loaded[1] = true
        INV.shells -= 1
        playId(SOUNDS.reload, 0.9, false)
    elseif chamber == 2 and not INV.loaded[2] then
        INV.loaded[2] = true
        INV.shells -= 1
        playId(SOUNDS.reload, 0.9, false, 1.12)
    else
        return false
    end
    refreshReloadUI()
    refreshInvUI()
    if INV.loaded[1] and INV.loaded[2] then
        task.delay(0.4, function()
            playId(SOUNDS.reload, 0.7, false, 0.8)
        end)
        task.delay(0.7, function()
            ST.reloadOpen = false
            tween(UI.reloadFrame, 0.2, { GroupTransparency = 1 })
            task.delay(0.2, function() UI.reloadFrame.Visible = false end)
        end)
    end
    return true
end

UI.shellSource.InputBegan:Connect(function(input)
    if INV.shells <= 0 or not ST.reloadOpen then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        ST.draggingShell = true
        UI.dragShell.Visible = true
        UI.dragShell.Position = UDim2.fromOffset(input.Position.X, input.Position.Y)
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if ST.draggingShell and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
        UI.dragShell.Position = UDim2.fromOffset(input.Position.X, input.Position.Y)
        local inC1 = input.Position.X > UI.chamber1.AbsolutePosition.X
            and input.Position.X < UI.chamber1.AbsolutePosition.X + UI.chamber1.AbsoluteSize.X
            and input.Position.Y > UI.chamber1.AbsolutePosition.Y
            and input.Position.Y < UI.chamber1.AbsolutePosition.Y + UI.chamber1.AbsoluteSize.Y
        local inC2 = input.Position.X > UI.chamber2.AbsolutePosition.X
            and input.Position.X < UI.chamber2.AbsolutePosition.X + UI.chamber2.AbsoluteSize.X
            and input.Position.Y > UI.chamber2.AbsolutePosition.Y
            and input.Position.Y < UI.chamber2.AbsolutePosition.Y + UI.chamber2.AbsoluteSize.Y
        UI.chamber1:FindFirstChild("St").Color = inC1 and C.blood or C.blood2
        UI.chamber2:FindFirstChild("St").Color = inC2 and C.blood or C.blood2
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if ST.draggingShell and (input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch) then
        ST.draggingShell = false
        UI.dragShell.Visible = false
        UI.chamber1:FindFirstChild("St").Color = C.blood2
        UI.chamber2:FindFirstChild("St").Color = C.blood2
        local inC1 = input.Position.X > UI.chamber1.AbsolutePosition.X
            and input.Position.X < UI.chamber1.AbsolutePosition.X + UI.chamber1.AbsoluteSize.X
            and input.Position.Y > UI.chamber1.AbsolutePosition.Y
            and input.Position.Y < UI.chamber1.AbsolutePosition.Y + UI.chamber1.AbsoluteSize.Y
        local inC2 = input.Position.X > UI.chamber2.AbsolutePosition.X
            and input.Position.X < UI.chamber2.AbsolutePosition.X + UI.chamber2.AbsoluteSize.X
            and input.Position.Y > UI.chamber2.AbsolutePosition.Y
            and input.Position.Y < UI.chamber2.AbsolutePosition.Y + UI.chamber2.AbsoluteSize.Y
        if inC1 then insertShell(1)
        elseif inC2 then insertShell(2) end
    end
end)
