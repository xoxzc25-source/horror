    local beacon = part({ Size = Vector3.new(0.8, 60, 0.8),
        Color = C.blood, Material = Enum.Material.Neon, Transparency = 0.7 })
    beacon.CFrame = CFrame.new(pos + Vector3.new(0, 30, 0))
    beacon.Parent = m
    local pl = Instance.new("PointLight")
    pl.Color = C.blood
    pl.Range = 20
    pl.Brightness = 2
    pl.Parent = beacon

    m.Parent = workspace
    shotgunModel = m
    shotgunWorldPos = pos

    local pr = Instance.new("ProximityPrompt")
    pr.ActionText = "ВЗЯТЬ ДВУХСТВОЛКУ"
    pr.ObjectText = "заряжена"
    pr.HoldDuration = 0.4
    pr.MaxActivationDistance = 8
    pr.RequiresLineOfSight = false
    pr.Parent = stock
    pr.Triggered:Connect(function(plr)
        if plr ~= LocalPlayer then return end
        if gunTool or INV.loaded[1] or INV.loaded[2] then
            setStatus("у тебя уже есть дробовик", true)
            return
        end
        INV.loaded[1] = true
        INV.loaded[2] = true
        monsterAware = true
        destroyShotgun()
        makeGunTool()
        refreshInvUI()
        setStatus("ДВУХСТВОЛКА У ТЕБЯ · V = перезарядка", true)
    end)
end

---------------------------------------------------------------- РИТУАЛ
stopRitualSafe = function(silent)
    running = false
    destroyMonster()
    destroyBrute()
    destroyWatcher()
    destroyStalker()
    destroyCrawler()
    destroyMother()
    destroyShotgun()
    for _, lb in ipairs(lootBoxes) do
        if lb.model then lb.model:Destroy() end
    end
    table.clear(lootBoxes)
    removeGunTool()
    if crowbarTool then crowbarTool:Destroy() crowbarTool = nil end
    setBloodFog(false)
    stopAllSounds()
    camera.FieldOfView = baseFOV
    staticHolder.Visible = false
    staticSnd = nil
    voicesSnd = nil
    ambientSnd = nil
    radarFrame.Visible = false
    radarOpen = false
    invFrame.Visible = false
    waveActive = false
    waveStartDelay = 0
    table.clear(waveCreatures)
    INV = { shells = 0, adrenaline = 0, crowbar = false, loaded = { false, false } }
    refreshInvUI()
    setStatus("тихо... пока что", false)
end

local function startRitual()
    if running then
        setStatus("испытание уже идёт", true)
        return
    end
    running = true
    monsterRage = 0
    rageStart = os.clock()
    monsterHP = 6
    monsterHits = 0
    monsterStagger = 0
    nextSummon = 0
    monsterAware = false
    waveActive = false
    waveStartDelay = 0
    waveKills = 0
    INV.shells = 0
    INV.adrenaline = 0
    INV.crowbar = false
    INV.loaded = { false, false }
    if crowbarTool then crowbarTool:Destroy() crowbarTool = nil end
    setStatus("ИСПЫТАНИЕ НАЧАЛОСЬ · выхода нет", true)
    task.spawn(function()
        doCountdown()
        if not running then return end
        local r = root()
        if not r then stopRitualSafe(true) return end

        local angle = math.rad(math.random(0, 359))
        local spawnPos = r.Position + Vector3.new(math.cos(angle) * 100, 0, math.sin(angle) * 100)
        spawnPos = Vector3.new(spawnPos.X, groundAt(spawnPos, r.Position.Y), spawnPos.Z)

        local built, eyes = buildMonster()
        monster = built
        monsterEyes = eyes
        monsterPos = spawnPos

        setBloodFog(true)
        spawnShotgun()
        spawnLootBoxes()
        ambientSnd = playId(SOUNDS.ambient, 0.4, true)
        voicesSnd = playId(SOUNDS.voices, 0, true, 0.85)
        staticSnd = playId(SOUNDS.static, 0, true)

        setStatus("ПРОЛОГ: они уже рядом · ищи дробовик, лом и патроны", true)
        nextScare = os.clock() + 8
        nextFar = os.clock() + math.random(4, 8)
        nextBehind = os.clock() + math.random(35, 70)
        nextFlicker = os.clock() + math.random(20, 50)

        radarOpen = true
        radarFrame.Visible = true
        refreshInvUI()

        task.delay(math.random(8, 15), function()
            if not running then return end
            local rr = root()
            if not rr then return end
            local a = math.rad(math.random(0, 359))
            watcher = buildWatcher(rr.Position + Vector3.new(math.cos(a) * 55, 0, math.sin(a) * 55))
            watcherAlive = true
        end)

        task.delay(2, function()
            if not running then return end
            local rr = root()
            if not rr then return end
            local lv = rr.CFrame.LookVector
            local p = rr.Position + Vector3.new(-lv.X, 0, -lv.Z) * 25
            p = Vector3.new(p.X, groundAt(p, rr.Position.Y), p.Z)
            stalker = buildStalker(p)
            stalkerPos = p
            stalkerState = "follow"
            stalkerTimer = os.clock() + math.random(14, 20)
            stalkerLookTime = 0
            stalkerWalkPhase = 0
            setStatus("кто-то идёт за тобой...", true)
        end)
        task.delay(6, function()
            if not running then return end
            local rr = root()
            if not rr then return end
            local a = math.rad(math.random(0, 359))
            local p = rr.Position + Vector3.new(math.cos(a) * 35, 0, math.sin(a) * 35)
            p = Vector3.new(p.X, groundAt(p, rr.Position.Y), p.Z)
            crawler = buildCrawler(p)
            crawlerPos = p
            crawlerState = "prowl"
            crawlerWalkPhase = 0
            setStatus("шорох с фланга...", true)
        end)
    end)
end

local function callStalker()
    if running then
        setStatus("сначала ритуал", true)
        return
    end
    local r = root()
    if not r then return end
    running = true
    setBloodFog(true)
    ambientSnd = playId(SOUNDS.ambient, 0.35, true)
    playId(SOUNDS.voices, 0.12, true, 0.85)
    local back = r.CFrame.LookVector * -25
    local pos = r.Position + back
    pos = Vector3.new(pos.X, groundAt(pos, r.Position.Y), pos.Z)
    stalker = buildStalker(pos)
    stalkerPos = pos
    stalkerState = "follow"
    stalkerTimer = os.clock() + math.random(12, 20)
    stalkerLookTime = 0
    stalkerWalkPhase = 0
    setStatus("за тобой кто-то идёт...", true)
    radarOpen = true
    radarFrame.Visible = true
end

---------------------------------------------------------------- ГЛАВНЫЙ ЦИКЛ
local warnedOnce = false
local lastStaticTick = 0
local lastRadarUpdate = 0
local lastHeavyTick = 0
local HEAVY_INTERVAL = 0.07

RunService.Heartbeat:Connect(function(dt)
    if flashOn then
        flashPart.CFrame = camera.CFrame
    end
    if camShake > 0 then
        camShake = math.max(0, camShake - dt * 1.2)
        camera.CFrame = camera.CFrame * CFrame.new(
            (math.random() - 0.5) * camShake,
            (math.random() - 0.5) * camShake, 0)
    end
    if not running then
        staticHolder.Visible = false
        if staticSnd then staticSnd.Volume = 0 end
        if voicesSnd then voicesSnd.Volume = 0 end
        return
    end

    local now = os.clock()
    local heavy = (now - lastHeavyTick) >= HEAVY_INTERVAL
    if heavy then lastHeavyTick = now end
    if now - lastRadarUpdate >= 0.35 then
        lastRadarUpdate = now
        updateRadar(now)
    end

    local ok, err = pcall(function()
        local r = root()
        if not r then return end
        local t = os.clock()
        local myPos = r.Position
        local camLook = camera.CFrame.LookVector
        local flatLook = Vector3.new(camLook.X, 0, camLook.Z)
        if flatLook.Magnitude > 0.01 then flatLook = flatLook.Unit end

        local h = myHum()
        if h then
            local bonus = (t < adrenalineUntil) and 3 or 0
            local target = baseWalkSpeed + bonus
            if h.WalkSpeed ~= target then h.WalkSpeed = target end
        end

        local elapsed = t - rageStart
        local newRage = 0
        for i, rt in ipairs(rageTimes) do
            if elapsed >= rt then newRage = i end
        end
        if newRage > monsterRage then
            monsterRage = newRage
            camShake = 0.5
            jumpscare(0.4, true)
            playId(SOUNDS.crypt, 0.8, false)
            setStatus("ОНО ЗВЕРЕЕТ · стадия " .. monsterRage .. "/4", true)
        end
        scareChance = 0.4 + monsterRage * 0.15

        -- МОНСТР
        if monsterPos then
            local toMe = (myPos - monsterPos) * Vector3.new(1, 0, 1)
            local dist = toMe.Magnitude
            local rageVis = monsterRage / 4
            local speed = 4.5 * (1 + monsterRage * 0.5)
            if monsterRage == 4 then speed = 4.5 * 2.8 end

            local dotToM = 0
            if dist > 0.5 then
                dotToM = flatLook:Dot(toMe.Unit)
            end
            if hasShotgun and dotToM > 0.9 and dist < 50 then
                speed = speed * 0.45
            end
            if hasShotgun then speed = speed * 0.85 end
            if t < monsterStagger then
                speed = 0
            end

            local targetPos = myPos
            if monsterAware and dist > 12 then
                targetPos = myPos - flatLook * 10
                if dotToM < -0.3 then targetPos = myPos end
            end

            local toTarget = (targetPos - monsterPos) * Vector3.new(1, 0, 1)
            local tDist = toTarget.Magnitude
            if tDist > 0.5 and speed > 0 then
                monsterPos += toTarget.Unit * math.min(speed * dt, tDist)
            end
            if dist > 170 then
                local a = math.rad(math.random(0, 359))
                monsterPos = myPos + Vector3.new(math.cos(a) * 90, 0, math.sin(a) * 90)
            end

            if heavy then
                local gy = groundAt(monsterPos, myPos.Y)
                local base = CFrame.lookAt(
                    Vector3.new(monsterPos.X, gy + MON_BASE_Y, monsterPos.Z),
                    Vector3.new(myPos.X, gy + MON_BASE_Y, myPos.Z))
                local swayFreq = 1.7 + rageVis * 2.5
                local sway = math.sin(t * swayFreq) * (0.04 + rageVis * 0.06)
                local twitch = 0
                if math.floor(t * (2 + monsterRage)) % 6 == 0 then
                    twitch = math.sin(t * (40 + monsterRage * 20)) * (0.035 + rageVis * 0.05)
                end
                if t < monsterStagger then
                    twitch = math.sin(t * 30) * 0.08
                    sway = math.sin(t * 12) * 0.1
                end
                local anim = CFrame.Angles(sway * 0.5, twitch, sway * 0.3)
                for _, e in ipairs(monsterParts) do
                    e.p.CFrame = base * e.off * anim
                end
                if monsterEyes then
                    local pulse = 0.5 + 0.5 * math.sin(t * (3 + monsterRage * 2))
                    for _, eye in ipairs(monsterEyes) do
                        eye.Color = C.blood:Lerp(Color3.fromRGB(255, 60, 60), pulse)
                        eye.Size = Vector3.one * (0.22 + pulse * 0.12 + rageVis * 0.08)
                    end
                end
            end

            local proximity = math.clamp(1 - dist / 130, 0, 1)
            if voicesSnd and voicesSnd.Parent then
                voicesSnd.Volume = math.clamp(1 - dist / 220, 0, 1) * 0.5
            end
            if staticSnd and staticSnd.Parent then
                staticSnd.Volume = math.clamp(1 - dist / 90, 0, 1) * 0.6
            end
            if heavy then
                local interference = math.clamp(proximity * (0.6 + rageVis * 0.4), 0, 1)
                setStaticIntensity(interference)
            end
            camera.FieldOfView = baseFOV + proximity * 5
                * math.abs(math.sin(t * (1.4 + proximity * 1.8) * math.pi))

            if t > nextFar then
                nextFar = t + math.random(8, 16) / (1 + monsterRage * 0.3)
                playId(SOUNDS.far, 0.35 + proximity * 0.55, false, 0.85 + math.random() * 0.3)
            end
            if t > nextScare then
                nextScare = t + math.random(20, 45) / (0.4 + scareChance)
                if math.random() < scareChance then
                    jumpscare(0.3, monsterRage >= 3)
                end
            end
            if monsterHits >= 2 and t > nextSummon then
                nextSummon = t + math.random(18, 25)
                local which = math.random(1, 2)
                local a = math.rad(math.random(0, 359))
                playId(SOUNDS.crypt, 0.9, false, 0.7)
                camShake = 0.3
                if which == 1 and not stalker then
                    local p = myPos + Vector3.new(math.cos(a) * 25, 0, math.sin(a) * 25)
                    p = Vector3.new(p.X, groundAt(p, myPos.Y), p.Z)
                    stalker = buildStalker(p)
                    stalkerPos = p
                    stalkerState = "follow"
                    stalkerTimer = os.clock() + math.random(10, 16)
                    stalkerLookTime = 0
                    stalkerWalkPhase = 0
                    setStatus("ОНО ЗОВЁТ СВОИХ...", true)
                elseif which == 2 and not crawler then
                    local p = myPos + Vector3.new(math.cos(a) * 40, 0, math.sin(a) * 40)
                    p = Vector3.new(p.X, groundAt(p, myPos.Y), p.Z)
                    crawler = buildCrawler(p)
                    crawlerPos = p
                    crawlerState = "prowl"
                    crawlerWalkPhase = 0
                    setStatus("ОНО ЗОВЁТ СВОИХ... шорох", true)
                end
            end
            if dist < 6.5 and t > monsterStagger then
                jumpscare(1, true)
                running = false
                task.delay(1.1, function()
                    stopRitualSafe(true)
                    deadBack.Visible = true
                    deadBack.BackgroundTransparency = 1
                    tween(deadBack, 0.4, { BackgroundTransparency = 0.08 })
                    setStatus("ты пойман", true)
                end)
                return
            end
        end

        -- ГРОМИЛА
        if not waveActive and not brute and monsterPos
            and (t - rageStart > 120 or monsterHits >= 3) then
            local a = math.rad(math.random(0, 359))
            local p = myPos + Vector3.new(math.cos(a) * 60, 0, math.sin(a) * 60)
            p = Vector3.new(p.X, groundAt(p, myPos.Y), p.Z)
            brute = buildBrute(p)
            brutePos = p
            bruteHP = 3
            bruteWalkPhase = 0
            setStatus("ЗЕМЛЯ ДРОЖИТ. ГРОМИЛА ИДЁТ. 3 патрона.", true)
            playId(SOUNDS.roar, 0.9, false, 0.7)
        end
        if brutePos and brute and not waveActive then
            local toMe = myPos - brutePos
            local flat = Vector3.new(toMe.X, 0, toMe.Z)
            local dist = flat.Magnitude
            local moving = dist > 6
            if moving and dist > 1 then
                brutePos += flat.Unit * math.min(3.5 * dt, dist)
                bruteWalkPhase += dt * 3.2
            end
            if heavy then
                local gy = groundAt(brutePos, myPos.Y)
                local base = CFrame.lookAt(
                    Vector3.new(brutePos.X, gy, brutePos.Z),
                    Vector3.new(myPos.X, gy, myPos.Z))
                local swing = moving and math.sin(bruteWalkPhase) * 0.35 or 0
                local idx = 0
                for _, e in ipairs(bruteParts) do
                    idx += 1
                    if idx >= 6 and idx <= 9 then
                        e.p.CFrame = base * e.off
                            * CFrame.Angles(swing * (idx % 2 == 0 and 1 or -1), 0, 0)
                    elseif idx >= 10 then
                        e.p.CFrame = base * e.off
                            * CFrame.Angles(-swing * (idx % 2 == 0 and 1 or -1), 0, 0)
                    else
                        e.p.CFrame = base * e.off
                    end
                end
            end
            if dist < 7 then
                if t > bruteNext then
                    bruteNext = t + 2
                    applyDamage(30)
                    camShake = 0.6
                    playId(SOUNDS.roar, 0.8, false, 0.8)
                end
            end
        end

        -- ВОЛНА
        if waveStartDelay > 0 and t > waveStartDelay then
            waveStartDelay = 0
            waveActive = true
            waveNextSpawn = 0
            setStatus("ВОЛНА. УБЕЙ ВСЕХ — И ТЫ ПЕРЕЖИВЁШЬ.", true)
            playId(SOUNDS.roar, 1, false)
            camShake = 0.6
            destroyStalker()
            destroyCrawler()
            destroyMother()
            destroyWatcher()
            destroyBrute()
        end
        if waveActive then
            if #waveCreatures < 14 and t > waveNextSpawn then
                waveNextSpawn = t + math.random(2, 4)
                for _ = 1, math.random(2, 3) do
                    local a = math.rad(math.random(0, 359))
                    local pos = myPos + Vector3.new(math.cos(a) * 300, 0, math.sin(a) * 300)
                    pos = Vector3.new(pos.X, groundAt(pos, myPos.Y), pos.Z)
                    local w = Instance.new("Model")
                    w.Name = "NF_Wave"
                    local skin = Color3.fromRGB(15, 12, 14)
                    local plist = {}
                    local function wp(props, off)
                        local p = part(props)
                        p.Parent = w
                        table.insert(plist, { p = p, off = off })
                        return p
                    end
                    wp({ Size = Vector3.new(2, 5, 1.2), Color = skin, Material = Enum.Material.Slate },
                        CFrame.new(0, 2.5, 0))
                    wp({ Size = Vector3.new(1.2, 1.4, 1.2), Color = skin,
                        Material = Enum.Material.Slate }, CFrame.new(0, 5.7, 0))
                    wp({ Size = Vector3.new(0.16, 0.16, 0.16), Shape = Enum.PartType.Ball,
                        Color = C.blood, Material = Enum.Material.Neon }, CFrame.new(-0.28, 5.8, -0.6))
                    wp({ Size = Vector3.new(0.16, 0.16, 0.16), Shape = Enum.PartType.Ball,
                        Color = C.blood, Material = Enum.Material.Neon }, CFrame.new(0.28, 5.8, -0.6))
                    wp({ Size = Vector3.new(0.5, 4.4, 0.5), Color = skin, Material = Enum.Material.Slate },
                        CFrame.new(-1.25, 2.6, 0))
                    wp({ Size = Vector3.new(0.5, 4.4, 0.5), Color = skin, Material = Enum.Material.Slate },
                        CFrame.new(1.25, 2.6, 0))
                    wp({ Size = Vector3.new(0.6, 2.4, 0.6), Color = skin, Material = Enum.Material.Slate },
                        CFrame.new(-0.5, 1.2, 0))
                    wp({ Size = Vector3.new(0.6, 2.4, 0.6), Color = skin, Material = Enum.Material.Slate },
                        CFrame.new(0.5, 1.2, 0))
                    w.PrimaryPart = plist[1].p
                    w:PivotTo(CFrame.lookAt(pos, myPos))
                    w.Parent = workspace
                    table.insert(waveCreatures, {
                        model = w, plist = plist, pos = pos,
                        speed = math.random(11, 16),
                    })
                end
            end
            local nearest = nil
            local alive = {}
            for _, wc in ipairs(waveCreatures) do
                if wc.model and wc.model.Parent then
                    local cPos = wc.pos
                    local toMe = myPos - cPos
                    local flat = Vector3.new(toMe.X, 0, toMe.Z)
                    local d = flat.Magnitude
                    if d > 1 then
                        cPos += flat.Unit * math.min(wc.speed * dt, d)
                    end
                    wc.pos = cPos
                    if heavy then
                        local gy = groundAt(cPos, myPos.Y)
                        local base = CFrame.lookAt(
                            Vector3.new(cPos.X, gy, cPos.Z),
                            Vector3.new(myPos.X, gy, myPos.Z))
                        local swing = math.sin(t * 8 + wc.speed) * 0.4
                        for _, pe in ipairs(wc.plist) do
                            if pe.off.Position.Y > 4 then
                                pe.p.CFrame = base * pe.off
                                    * CFrame.Angles(swing * (pe.off.Position.X < 0 and 1 or -1), 0, 0)
                            else
                                pe.p.CFrame = base * pe.off
                            end
                        end
                    end
                    if d < 4 then
                        applyDamage(10)
                        wc.model:Destroy()
                    else
                        table.insert(alive, wc)
                        if not nearest or d < nearest then nearest = d end
                    end
                end
            end
            waveCreatures = alive
            waveNearest = nearest
            -- ПОБЕДА: спавн иссяк и всех перебил
            if #waveCreatures == 0 and t > waveNextSpawn and waveKills >= 3 then
                running = false
                waveActive = false
                stopRitualSafe(true)
                winBack.Visible = true
                winBack.BackgroundTransparency = 1
                tween(winBack, 0.6, { BackgroundTransparency = 0.05 })
                winSub.Text = "рассвет близко..."
                tween(survivedLbl, 1, { TextTransparency = 0 })
                playId(SOUNDS.ambient, 0.5, false, 1.1)
            end
        end

        -- СТОКЕР
        if stalkerPos and stalkerState ~= "none" and not waveActive then
            if stalkerState == "follow" then
                local target = myPos - flatLook * 22
                local toT = target - stalkerPos
                toT = Vector3.new(toT.X, 0, toT.Z)
                local d = toT.Magnitude
                if d > 0.5 then
                    stalkerPos += toT.Unit * math.min(10.5 * dt, d)
                    stalkerWalkPhase += dt * 6
                end
                if d > 70 then
                    stalkerPos = myPos - flatLook * 26
                end
                local toS = stalkerPos - myPos
                local looking = toS.Magnitude > 0.5
                    and flatLook:Dot(Vector3.new(toS.X, 0, toS.Z).Unit) > 0.6
                    and toS.Magnitude < 60
                if looking then
                    stalkerLookTime += dt
                    if stalkerLookTime > 1.2 then
                        stalkerState = "charge"
                        stalkerLookTime = 0
                        camShake = 0.4
                        setStatus("ОНО ПОБЕЖАЛО. БЕГИ.", true)
                    end
                else
                    stalkerLookTime = math.max(0, stalkerLookTime - dt)
                end
                if t > stalkerTimer then
                    stalkerState = "charge"
                    camShake = 0.4
                    setStatus("ОНО БЕЖИТ. БЕГИ.", true)
                end
            elseif stalkerState == "charge" then
                local toMe = myPos - stalkerPos
                toMe = Vector3.new(toMe.X, 0, toMe.Z)
                local d = toMe.Magnitude
                if d > 0.5 then
                    stalkerPos += toMe.Unit * math.min(26 * dt, d)
                    stalkerWalkPhase += dt * 11
                end
                camShake = math.max(camShake, 0.15)
                if d < 4 then
                    applyDamage(15)
                    destroyStalker()
                    setStatus("оно ударило и исчезло...", true)
                end
            end
            if heavy and stalker and stalker.Parent then
                local moving = (stalkerState == "charge")
                local gy = groundAt(stalkerPos, myPos.Y)
                local base = CFrame.lookAt(
                    Vector3.new(stalkerPos.X, gy, stalkerPos.Z),
                    Vector3.new(myPos.X, gy, myPos.Z))
                local speed = moving and 11 or 6
                local swing = math.sin(stalkerWalkPhase) * (moving and 0.9 or 0.55)
                for _, e in ipairs(stalkerParts) do
                    if e.half == 0 then
                        e.p.CFrame = base * e.pivot
                    else
                        e.p.CFrame = base * e.pivot
                            * CFrame.Angles(swing * e.sign, 0, 0)
                            * CFrame.new(0, -e.half, 0)
                    end
                end
            end
        end

        -- ПОЛЗУН
        if crawlerState == "prowl" and crawler then
            local toMe = myPos - crawlerPos
            local flat = Vector3.new(toMe.X, 0, toMe.Z)
            local dist = flat.Magnitude
            local dirToC = crawlerPos - myPos
            local seen = dist > 0.5
                and flatLook:Dot(Vector3.new(dirToC.X, 0, dirToC.Z).Unit) > 0.5
                and dist < 60

            local spd = seen and 2 or (dist > 25 and 9 or 4.5)
            if dist > 0.5 then
                crawlerPos += flat.Unit * math.min(spd * dt, dist)
                crawlerWalkPhase += dt * spd * 1.8
            end

            if dist < 3.5 then
                applyDamage(12)
                jumpscare(0.35)
                destroyCrawler()
                task.delay(math.random(15, 25), function()
                    if not running then return end
                    local rr = root()
                    if not rr then return end
                    local a = math.rad(math.random(0, 359))
                    local p = rr.Position + Vector3.new(math.cos(a) * 40, 0, math.sin(a) * 40)
                    p = Vector3.new(p.X, groundAt(p, rr.Position.Y), p.Z)
                    crawler = buildCrawler(p)
                    crawlerPos = p
                    crawlerState = "prowl"
                    crawlerWalkPhase = 0
                    setStatus("шорох снова...", true)
                end)
            else
                if heavy then
                    local gy = groundAt(crawlerPos, myPos.Y)
                    local base = CFrame.lookAt(
                        Vector3.new(crawlerPos.X, gy + 0.6, crawlerPos.Z),
                        Vector3.new(myPos.X, gy + 0.6, myPos.Z))
                    local partsByName = {}
                    for _, e in ipairs(crawlerParts) do
                        partsByName[e.name] = e
                    end
                    local crawlWave = math.sin(crawlerWalkPhase * 2) * 0.12
                    local bob = math.abs(math.sin(crawlerWalkPhase)) * 0.2
                    local roll = math.sin(crawlerWalkPhase) * 0.12
                    for _, e in ipairs(crawlerParts) do
                        if e.name == "torso" then
                            e.p.CFrame = base * e.off
                                * CFrame.new(0, bob, 0)
                                * CFrame.Angles(crawlWave, 0, roll)
                        elseif e.name:sub(1, 3) == "rib" then
                            local ribN = tonumber(e.name:sub(4))
                            e.p.CFrame = base * e.off
                                * CFrame.new(0, bob, 0)
                                * CFrame.Angles(crawlWave, 0, roll)
                                * CFrame.Angles(0, 0, math.sin(crawlerWalkPhase * 2 + ribN) * 0.15)
                        end
                    end
                    local twitchHead = (math.floor(t * 4) % 3 == 0)
                        and math.sin(t * 60) * 0.06 or 0
                    local headNod = math.sin(crawlerWalkPhase * 2) * 0.12
                    if partsByName.head then
                        partsByName.head.p.CFrame = base * partsByName.head.off
                            * CFrame.new(0, bob, 0)
                            * CFrame.Angles(headNod + twitchHead, twitchHead, roll)
                    end
                    local jawDrop = math.abs(math.sin(t * 6)) * 0.25
                    if partsByName.jaw then
                        partsByName.jaw.p.CFrame = base * partsByName.jaw.off
                            * CFrame.new(0, bob, 0)
                            * CFrame.Angles(math.rad(45) + jawDrop + headNod, 0, roll)
                    end
                    for _, nm in ipairs({ "eyeL", "eyeR", "mouth" }) do
                        if partsByName[nm] then
                            partsByName[nm].p.CFrame = base * partsByName[nm].off
                                * CFrame.new(0, bob, 0) * CFrame.Angles(headNod, twitchHead, roll)
                        end
                    end
                    local limbSwing = math.sin(crawlerWalkPhase) * 0.55
                    if partsByName.armL then
                        partsByName.armL.p.CFrame = base * partsByName.armL.off
                            * CFrame.Angles(limbSwing, 0, 0)
                            * CFrame.new(0, -partsByName.armL.p.Size.Y / 2, -limbSwing * 0.4)
                    end
                    if partsByName.armR then
                        partsByName.armR.p.CFrame = base * partsByName.armR.off
                            * CFrame.Angles(-limbSwing, 0, 0)
                            * CFrame.new(0, -partsByName.armR.p.Size.Y / 2, limbSwing * 0.4)
                    end
                    if partsByName.legL then
                        partsByName.legL.p.CFrame = base * partsByName.legL.off
                            * CFrame.Angles(-limbSwing, 0, 0)
                            * CFrame.new(0, -partsByName.legL.p.Size.Y / 2, limbSwing * 0.4)
                    end
                    if partsByName.legR then
                        partsByName.legR.p.CFrame = base * partsByName.legR.off
                            * CFrame.Angles(limbSwing, 0, 0)
                            * CFrame.new(0, -partsByName.legR.p.Size.Y / 2, -limbSwing * 0.4)
                    end
                end
            end
        end

        -- МАТЬ
        if not waveActive and not mother and monsterPos and t - rageStart > 70 then
            local a = math.rad(math.random(0, 359))
            local p = myPos + Vector3.new(math.cos(a) * 35, 0, math.sin(a) * 35)
            p = Vector3.new(p.X, groundAt(p, myPos.Y), p.Z)
            mother = buildMother(p)
            motherPos = p
            motherNext = t + 1.5
            motherTilt = 0
            setStatus("ОНА ЗДЕСЬ. НЕ ОТВОДИ ВЗГЛЯД.", true)
        end
        if motherPos and mother and not waveActive then
            local toMe = myPos - motherPos
            local flat = Vector3.new(toMe.X, 0, toMe.Z)
            local dist = flat.Magnitude
            local dirToM = motherPos - myPos
            local seen = dist > 0.5
                and flatLook:Dot(Vector3.new(dirToM.X, 0, dirToM.Z).Unit) > 0.25
                and dist < 120
            if not seen and t > motherNext then
                motherNext = t + math.random(0.8, 2)
                if dist > 5 then
                    local step = math.random(6, 10)
                    local jitter = Vector3.new(math.random(-4, 4), 0, math.random(-4, 4))
                    motherPos = motherPos + flat.Unit * math.min(step, dist - 2) + jitter
                    motherPos = Vector3.new(motherPos.X, groundAt(motherPos, myPos.Y), motherPos.Z)
                    motherTilt = (motherTilt + math.random(20, 45)) % 180
                    setStaticIntensity(0.85)
                    playId(SOUNDS.static, 0.5, false, math.random(70, 130) / 100)
                    camShake = math.max(camShake, 0.25)
                    task.delay(0.15, function() setStaticIntensity(0) end)
                end
            end
            if dist < 10 and dist > 0.1 then
                if not mother:GetAttribute("grind") or t - mother:GetAttribute("grind") > 1 then
                    mother:SetAttribute("grind", t)
                    playId(SOUNDS.static, 0.4, false, 0.5)
                end
            end
            if dist < 5 then
                applyDamage(25)
                jumpscare(0.5, true)
                destroyMother()
                task.delay(math.random(25, 40), function()
                    if not running then return end
                    local rr = root()
                    if not rr then return end
                    local a = math.rad(math.random(0, 359))
                    local p = rr.Position + Vector3.new(math.cos(a) * 35, 0, math.sin(a) * 35)
                    p = Vector3.new(p.X, groundAt(p, rr.Position.Y), p.Z)
                    mother = buildMother(p)
                    motherPos = p
                    motherTilt = 0
                end)
            end
            if heavy and mother and mother.Parent then
                local gy = groundAt(motherPos, myPos.Y)
                local base = CFrame.lookAt(
                    Vector3.new(motherPos.X, gy, motherPos.Z),
                    Vector3.new(myPos.X, gy, myPos.Z))
                    * CFrame.Angles(0, 0, math.rad(motherTilt))
                for _, e in ipairs(motherParts) do
                    e.p.CFrame = base * e.off
                end
            end
        end

        -- СИЛУЭТ
        if watcherAlive and watcher then
            local wPos = watcher:GetPivot().Position
            local flat = Vector3.new(myPos.X, wPos.Y, myPos.Z)
            local wDist = (myPos - wPos).Magnitude
            local lookW = CFrame.lookAt(Vector3.new(wPos.X, wPos.Y, wPos.Z), flat)
            for _, e in ipairs(watcherParts) do
                e.p.CFrame = lookW * e.off
            end
            if wDist < 12 then
                for _, e in ipairs(watcherParts) do
                    local pe = Instance.new("ParticleEmitter")
                    pe.Rate = 120
                    pe.Lifetime = NumberRange.new(0.5, 1)
                    pe.Speed = NumberRange.new(2, 5)
                    pe.Size = NumberSequence.new(0.3)
                    pe.Color = ColorSequence.new(Color3.fromRGB(15, 15, 18))
                    pe.Transparency = NumberSequence.new(0.3)
                    pe.Parent = e.p
                end
                camShake = 0.2
                local w = watcher
                watcherAlive = false
                watcher = nil
                task.delay(1.4, function() w:Destroy() end)
                task.delay(math.random(20, 40), function()
                    if not running then return end
                    local rr = root()
                    if not rr then return end
                    local a = math.rad(math.random(0, 359))
                    watcher = buildWatcher(rr.Position + Vector3.new(math.cos(a) * 60, 0, math.sin(a) * 60))
                    watcherAlive = true
                end)
            end
        end

        if t > nextBehind and not waveActive then
            nextBehind = t + math.random(40, 90)
            flashBehindEvent()
            local p = myPos - flatLook * 7
            p = Vector3.new(p.X, groundAt(p, myPos.Y), p.Z)
            local gw = buildWatcher(p)
            task.delay(2.5, function() if gw then gw:Destroy() end end)
        end
        if t > nextFlicker then
            nextFlicker = t + math.random(25, 60)
            task.spawn(function()
                for _ = 1, 6 do
                    Lighting.Brightness = math.random(1, 10) / 10
                    if flashOn then spot.Enabled = math.random() > 0.5 end
                    task.wait(0.07)
                end
                Lighting.Brightness = 0.8
                if flashOn then spot.Enabled = true end
            end)
            playId(SOUNDS.voices, 0.2, false, 1.15)
        end
    end)

    if not ok and not warnedOnce then
        warnedOnce = true
        warn("[Nightfall] ошибка цикла:", err)
    end
end)

---------------------------------------------------------------- СТРЕЛЬБА / ЛОМ
local crowbarSwingT = 0

local function pickShotTarget(origin, dir)
    local best, bestDist = nil, math.huge
    local function test(pos, radius, height, kind)
        if rayHitsCylinder(origin, dir, pos, radius, height) then
            local d = (pos - origin).Magnitude
            if d < bestDist then
                bestDist = d
                best = kind
            end
        end
    end
    if monsterPos then
        test(monsterPos, 4, 15, "monster")
    end
    if brutePos then
        test(brutePos, 4.5, 14, "brute")
    end
    if stalkerPos and stalkerState ~= "none" then
        test(stalkerPos, 2.5, 7, "stalker")
    end
    if crawlerState == "prowl" and crawlerPos then
        test(crawlerPos, 2.5, 3, "crawler")
    end
    for i, wc in ipairs(waveCreatures) do
        if wc.model and wc.model.Parent then
            test(wc.pos, 2, 7, "wave_" .. i)
        end
    end
    return best
end

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("Лом") then
            local now = os.clock()
            if now - crowbarSwingT > 0.9 then
                crowbarSwingT = now
                playId(SOUNDS.crowbarHit, 0.9, false, math.random(90, 110) / 100)
                local r = root()
                if r then
                    local killed = false
                    if stalkerPos and stalkerState ~= "none" then
                        local d = (r.Position - stalkerPos).Magnitude
                        if d < 6 then
                            playId(SOUNDS.crowbarHit, 1, false, 0.8)
                            destroyStalker()
                            killed = true
                            setStatus("ЛОМ: стокер уничтожен", false)
                        end
                    end
                    if not killed and crawlerState == "prowl" and crawlerPos then
                        local d = (r.Position - crawlerPos).Magnitude
                        if d < 6 then
                            playId(SOUNDS.crowbarHit, 1, false, 0.8)
                            destroyCrawler()
                            killed = true
                            setStatus("ЛОМ: ползун уничтожен", false)
                        end
                    end
                    if not killed then
                        setStatus("мимо · лом не берёт босса/Громилу/Мать", true)
                    end
                end
            end
        elseif char and char:FindFirstChild("Двухстволка") then
            if INV.loaded[1] or INV.loaded[2] then
                playId(SOUNDS.shot, 1, false)
                local muzzle = gunTool and gunTool:FindFirstChild("Muzzle")
                if muzzle then
                    local flash = part({ Size = Vector3.new(0.8, 0.8, 0.8),
                        Shape = Enum.PartType.Ball,
                        Color = Color3.fromRGB(255, 220, 120), Material = Enum.Material.Neon })
                    flash.CFrame = muzzle.CFrame
                    flash.Parent = workspace
                    local light = Instance.new("PointLight")
                    light.Color = Color3.fromRGB(255, 210, 120)
                    light.Range = 28
                    light.Brightness = 5
                    light.Parent = flash
                    task.delay(0.09, function() flash:Destroy() end)
                end
                camShake = math.max(camShake, 0.35)
                local r = root()
                if r then
                    r.AssemblyLinearVelocity -= camera.CFrame.LookVector * 14
                end
                if INV.loaded[1] then INV.loaded[1] = false
                elseif INV.loaded[2] then INV.loaded[2] = false end
                refreshInvUI()

                local origin = camera.CFrame.Position
                local dir = camera.CFrame.LookVector
                local target = pickShotTarget(origin, dir)

                if target == "monster" then
                    monsterHP -= 1
                    monsterHits += 1
                    monsterStagger = os.clock() + 2
                    monsterRage = math.min(4, monsterRage + 1)
                    rageStart = math.min(rageStart, os.clock() - (rageTimes[monsterRage] or 0) - 1)
                    playId(SOUNDS.roar, 1, false, math.random(85, 105) / 100)
                    camShake = 0.6
                    if monsterEyes then
                        for _, eye in ipairs(monsterEyes) do
                            eye.Color = Color3.fromRGB(255, 255, 255)
                            eye.Size = Vector3.one * 0.55
                        end
                    end
                    task.delay(2, function()
                        if monsterEyes then
                            for _, eye in ipairs(monsterEyes) do
                                eye.Color = C.blood
                                eye.Size = Vector3.one * 0.25
                            end
                        end
                    end)
                    if monsterHP <= 0 then
                        print("[Nightfall] БОСС УБИТ")
                        destroyMonster()
                        monsterPos = nil
                        jumpscare(0.6, true)
                        winBack.Visible = true
                        winBack.BackgroundTransparency = 1
                        tween(winBack, 0.4, { BackgroundTransparency = 0.08 })
                        winSub.Text = "но снаружи что-то проснулось..."
                        task.delay(6, function()
                            tween(winBack, 0.5, { BackgroundTransparency = 1 })
                            task.delay(0.5, function()
                                winBack.Visible = false
                                waveStartDelay = os.clock() + 4
                            end)
                        end)
                    else
                        setStatus("ПОПАДАНИЕ · " .. (6 - monsterHP) .. "/6", true)
                    end
                elseif target == "brute" then
                    bruteHP -= 1
                    playId(SOUNDS.roar, 0.9, false, 0.7)
                    camShake = 0.5
                    if bruteHP <= 0 then
                        destroyBrute()
                        setStatus("ГРОМИЛА ПОВЕРЖЕН", false)
                    else
                        setStatus("ГРОМИЛА · осталось: " .. bruteHP, true)
                    end
                elseif target == "stalker" then
                    playId(SOUNDS.scream, 0.9, false, 1.2)
                    destroyStalker()
                    setStatus("ВЫСТРЕЛ: стокер уничтожен", false)
                elseif target == "crawler" then
                    playId(SOUNDS.scream, 0.9, false, 1.35)
                    destroyCrawler()
                    setStatus("ВЫСТРЕЛ: ползун уничтожен", false)
                elseif target and target:sub(1, 5) == "wave_" then
                    local idx = tonumber(target:sub(6))
                    local wc = waveCreatures[idx]
                    if wc and wc.model and wc.model.Parent then
                        playId(SOUNDS.scream, 0.8, false, 1.25)
                        wc.model:Destroy()
                        waveKills += 1
                        table.remove(waveCreatures, idx)
                        setStatus("ВЫСТРЕЛ: тварь волны уничтожена", false)
                    else
                        setStatus("ПРОМАХ", true)
                    end
                else
                    setStatus("ПРОМАХ", true)
                end
            else
                setStatus("ПУСТО · V = перезарядка", true)
            end
        end
    end
    if input.KeyCode == Enum.KeyCode.F then
        setFlash(not flashOn)
    elseif input.KeyCode == Enum.KeyCode.V then
        toggleReloadUI()
    elseif input.KeyCode == Enum.KeyCode.RightShift then
        local isOpen = panel.Visible
        if isOpen then
            tween(panel, 0.2, { GroupTransparency = 1 })
            tween(panelScale, 0.2, { Scale = 0.94 })
            task.delay(0.2, function() panel.Visible = false end)
            openBtn.Visible = true
        else
            panel.Visible = true
            panel.GroupTransparency = 1
            panelScale.Scale = 0.94
            tween(panel, 0.25, { GroupTransparency = 0 })
            tween(panelScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
            openBtn.Visible = false
        end
    end
end)

