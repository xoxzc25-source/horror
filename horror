local function distTo(pos)
    local r = root()
    if not (r and pos) then return nil end
    local flat = r.Position - pos
    return math.floor(Vector3.new(flat.X, 0, flat.Z).Magnitude)
end

local function updateRadar(now)
    if not ST.radarOpen then return end
    if now - T.lastShotgunPing >= 5 then
        T.lastShotgunPing = now
        ST.lastPingBlink = now
    end
    local blink = (now - ST.lastPingBlink) < 0.6

    local haveGun = gunTool ~= nil or INV.loaded[1] or INV.loaded[2] or INV.shells > 0
    local d = distTo(ST.shotgunWorldPos)
    if d and not haveGun then
        UI.radarRows.shotgun.Text = (blink and "▸ " or "") .. d .. " ст"
        UI.radarRows.shotgun.Visible = true
    elseif haveGun then
        UI.radarRows.shotgun.Text = "у тебя"
        UI.radarRows.shotgun.Visible = true
    else
        UI.radarRows.shotgun.Visible = false
    end

    ST.nearestLoot = nil
    local minLD = math.huge
    for _, lb in ipairs(ST.lootBoxes) do
        if lb.model and lb.model.Parent then
            local ld = distTo(lb.pos)
            if ld and ld < minLD then minLD = ld ST.nearestLoot = ld end
        end
    end
    if ST.nearestLoot then
        UI.radarRows.loot.Text = ST.nearestLoot .. " ст"
        UI.radarRows.loot.Visible = true
    else
        UI.radarRows.loot.Visible = false
    end

    d = distTo(ST.monsterPos)
    UI.radarRows.monster.Visible = (d ~= nil and ST.monster ~= nil)
    if d and ST.monster then UI.radarRows.monster.Text = d .. " ст" end
    d = distTo(ST.brutePos)
    UI.radarRows.brute.Visible = (d ~= nil and ST.brute ~= nil)
    if d and ST.brute then UI.radarRows.brute.Text = d .. " ст(" .. ST.bruteHP .. ")" end
    d = distTo(ST.stalkerPos)
    UI.radarRows.stalker.Visible = (d ~= nil and ST.stalkerState ~= "none")
    if d and ST.stalkerState ~= "none" then UI.radarRows.stalker.Text = d .. " ст" end
    d = distTo(ST.crawlerPos)
    UI.radarRows.crawler.Visible = (d ~= nil and ST.crawlerState == "prowl")
    if d and ST.crawlerState == "prowl" then UI.radarRows.crawler.Text = d .. " ст" end
    d = distTo(ST.motherPos)
    UI.radarRows.mother.Visible = (d ~= nil and ST.mother ~= nil)
    if d and ST.mother then UI.radarRows.mother.Text = d .. " ст" end
    if ST.waveActive then
        UI.radarRows.wave.Text = ST.waveNearest and (ST.waveNearest .. " ст") or "..."
        UI.radarRows.wave.Visible = true
        UI.radarHint.Text = "ВОЛНА: убей всех!"
        UI.radarHint.TextColor3 = C.blood
    else
        UI.radarRows.wave.Visible = false
        UI.radarHint.Text = ""
    end
end

