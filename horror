---------------------------------------------------------------- helpers
local function New(class, props, kids)
    local inst = Instance.new(class)
    if inst:IsA("GuiObject") then inst.BorderSizePixel = 0 end
    for k, v in pairs(props) do inst[k] = v end
    if kids then for _, kid in ipairs(kids) do kid.Parent = inst end end
    return inst
end

local function tween(inst, ti, props, style)
    TweenService:Create(inst, TweenInfo.new(ti,
        style or Enum.EasingStyle.Quart, Enum.EasingDirection.Out), props):Play()
end

local function ord()
    T.order += 1
    return T.order
end

local function root()
    local c = LocalPlayer.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function myHum()
    local c = LocalPlayer.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function part(props)
    local p = New("Part", {
        Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
        CastShadow = false, TopSurface = Enum.SurfaceType.Smooth,
        BottomSurface = Enum.SurfaceType.Smooth,
    })
    for k, v in pairs(props) do p[k] = v end
    return p
end

local function groundAt(pos, fallbackY)
    local ray = workspace:Raycast(pos + Vector3.new(0, 100, 0), Vector3.new(0, -400, 0))
    if ray then return ray.Position.Y end
    return fallbackY
end

local function rayHitsCylinder(origin, dir, center, radius, height)
    local mid = center + Vector3.new(0, height / 2, 0)
    local toMid = mid - origin
    local along = toMid:Dot(dir)
    if along < 0 then return false end
    local closest = origin + dir * along
    local flat = closest - mid
    flat = Vector3.new(flat.X, 0, flat.Z)
    return flat.Magnitude <= radius
end

