local function spawnLootBoxes()
    for _, lb in ipairs(lootBoxes) do
        if lb.model then lb.model:Destroy() end
    end
    table.clear(lootBoxes)
    local r = root()
    if not r then return end
    local contents_list = { "shells", "shells", "shells", "shells", "shells", "shells",
        "crowbar", "crowbar", "crowbar",
        "adrenaline", "adrenaline", "adrenaline" }
    for i = #contents_list, 2, -1 do
        local j = math.random(i)
        contents_list[i], contents_list[j] = contents_list[j], contents_list[i]
    end

    for i = 1, 12 do
        local a = math.rad((i / 12) * 360 + math.random(-25, 25))
        local d = math.random(25, 100)
        local pos = r.Position + Vector3.new(math.cos(a) * d, 0, math.sin(a) * d)
        pos = Vector3.new(pos.X, groundAt(pos, r.Position.Y), pos.Z)

        local m = Instance.new("Model")
        m.Name = "NF_Loot"
        local box = part({ Size = Vector3.new(1.4, 1, 1.4),
            Color = Color3.fromRGB(70, 55, 40), Material = Enum.Material.Wood })
        box.CFrame = CFrame.new(pos + Vector3.new(0, 0.5, 0))
            * CFrame.Angles(0, math.rad(math.random(0, 359)), 0)
        box.Parent = m
        local glow = part({ Size = Vector3.new(0.3, 0.3, 0.3), Shape = Enum.PartType.Ball,
            Color = Color3.fromRGB(120, 255, 140), Material = Enum.Material.Neon,
            Transparency = 0.3 })
        glow.CFrame = box.CFrame * CFrame.new(0, 0.8, 0)
        glow.Parent = m
        m.Parent = workspace

        local contents = contents_list[i]

        local pr = Instance.new("ProximityPrompt")
        pr.ActionText = "ОТКРЫТЬ ЯЩИК"
        pr.ObjectText = "?"
        pr.HoldDuration = 0.5
        pr.MaxActivationDistance = 7
        pr.RequiresLineOfSight = false
        pr.Parent = box
        pr.Triggered:Connect(function(plr)
            if plr ~= LocalPlayer then return end
            if contents == "adrenaline" then
                INV.adrenaline += 1
                setStatus("найдено: АДРЕНАЛИН", false)
            elseif contents == "shells" then
                INV.shells += 2
                setStatus("найдено: 2 ПАТРОНА", false)
            elseif contents == "crowbar" then
                INV.crowbar = true
                makeCrowbarTool()
                setStatus("найдено: ЛОМ · хотбар", false)
            else
                setStatus("ящик пуст...", true)
            end
            refreshInvUI()
            for _, j in ipairs(lootBoxes) do
                if j.model == m then j.model = nil end
            end
            m:Destroy()
        end)

        table.insert(lootBoxes, { model = m, pos = pos })
    end
end

