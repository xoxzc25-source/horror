    Font = F.bold, TextSize = 11, TextColor3 = C.dim,
    Size = UDim2.fromOffset(140, 30), AnchorPoint = Vector2.new(0.5, 1),
    Position = UDim2.new(0.5, 0, 1, -10), Parent = reloadFrame,
}, { New("UICorner", { CornerRadius = UDim.new(0, 8) }) })

local function refreshReloadUI()
    ch1Label.TextTransparency = INV.loaded[1] and 1 or 0
    ch2Label.TextTransparency = INV.loaded[2] and 1 or 0
    shellIcon1.Visible = INV.loaded[1]
    shellIcon2.Visible = INV.loaded[2]
    shellSrcCount.Text = "×" .. INV.shells
end

local function insertShell(chamber)
    if INV.shells <= 0 then return false end
    if chamber == 1 and not INV.loaded[1] then
        INV.loaded[1] = true
        INV.shells -= 1
        playId(SOUNDS.reload, 0.9, false)
    elseif chamber == 2 and not INV.loaded[2] then
        INV.loaded[2] = true
        INV.shells -= 1
        playId(SOUNDS.reload, 0.9, false, 1.12)
    else
        return false
    end
    refreshReloadUI()
    refreshInvUI()
    if INV.loaded[1] and INV.loaded[2] then
        task.delay(0.4, function()
            playId(SOUNDS.reload, 0.7, false, 0.8)
        end)
        task.delay(0.7, function()
            reloadOpen = false
            tween(reloadFrame, 0.2, { GroupTransparency = 1 })
            task.delay(0.2, function() reloadFrame.Visible = false end)
        end)
    end
    return true
end

local draggingShell = false
shellSource.InputBegan:Connect(function(input)
    if INV.shells <= 0 or not reloadOpen then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        draggingShell = true
        dragShell.Visible = true
        dragShell.Position = UDim2.fromOffset(input.Position.X, input.Position.Y)
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if draggingShell and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
        dragShell.Position = UDim2.fromOffset(input.Position.X, input.Position.Y)
        local inC1 = input.Position.X > chamber1.AbsolutePosition.X
            and input.Position.X < chamber1.AbsolutePosition.X + chamber1.AbsoluteSize.X
            and input.Position.Y > chamber1.AbsolutePosition.Y
            and input.Position.Y < chamber1.AbsolutePosition.Y + chamber1.AbsoluteSize.Y
        local inC2 = input.Position.X > chamber2.AbsolutePosition.X
            and input.Position.X < chamber2.AbsolutePosition.X + chamber2.AbsoluteSize.X
            and input.Position.Y > chamber2.AbsolutePosition.Y
            and input.Position.Y < chamber2.AbsolutePosition.Y + chamber2.AbsoluteSize.Y
        chamber1:FindFirstChild("St").Color = inC1 and C.blood or C.blood2
        chamber2:FindFirstChild("St").Color = inC2 and C.blood or C.blood2
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if draggingShell and (input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch) then
        draggingShell = false
        dragShell.Visible = false
        chamber1:FindFirstChild("St").Color = C.blood2
        chamber2:FindFirstChild("St").Color = C.blood2
        local inC1 = input.Position.X > chamber1.AbsolutePosition.X
            and input.Position.X < chamber1.AbsolutePosition.X + chamber1.AbsoluteSize.X
            and input.Position.Y > chamber1.AbsolutePosition.Y
            and input.Position.Y < chamber1.AbsolutePosition.Y + chamber1.AbsoluteSize.Y
        local inC2 = input.Position.X > chamber2.AbsolutePosition.X
            and input.Position.X < chamber2.AbsolutePosition.X + chamber2.AbsoluteSize.X
            and input.Position.Y > chamber2.AbsolutePosition.Y
            and input.Position.Y < chamber2.AbsolutePosition.Y + chamber2.AbsoluteSize.Y
        if inC1 then insertShell(1)
        elseif inC2 then insertShell(2) end
    end
end)
closeReload.Activated:Connect(function()
    reloadOpen = false
    tween(reloadFrame, 0.2, { GroupTransparency = 1 })
    task.delay(0.2, function() reloadFrame.Visible = false end)
end)
local function toggleReloadUI()
    if not gunTool then
        setStatusSafe("возьми дробовик в руки (хотбар)", true)
        return
    end
    reloadOpen = not reloadOpen
    if reloadOpen then
        refreshReloadUI()
        reloadFrame.Visible = true
        reloadFrame.GroupTransparency = 1
        tween(reloadFrame, 0.2, { GroupTransparency = 0 })
    else
        tween(reloadFrame, 0.2, { GroupTransparency = 1 })
        task.delay(0.2, function() reloadFrame.Visible = false end)
    end
end

