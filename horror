makeGunTool = function()
    if gunTool then gunTool:Destroy() end
    local char = LocalPlayer.Character
    if not char then return end
    gunTool = Instance.new("Tool")
    gunTool.Name = "Двухстволка"
    gunTool.RequiresHandle = true
    gunTool.CanBeDropped = false
    gunTool.GripPos = Vector3.new(0, -0.25, 0.7)
    local woodDark = Color3.fromRGB(82, 54, 30)
    local steel = Color3.fromRGB(45, 42, 40)
    local function np(name, size, color, material)
        local p = Instance.new("Part")
        p.Name = name
        p.Size = size
        p.Color = color
        p.Material = material
        p.CanCollide = false
        p.Parent = gunTool
        return p
    end
    local function weld(a, b, cf)
        local w = Instance.new("Weld")
        w.Part0 = a
        w.Part1 = b
        w.C0 = cf
        w.Parent = b
    end
    local stock = np("Handle", Vector3.new(0.42, 0.55, 3), woodDark, Enum.Material.WoodPlanks)
    local b1 = np("B1", Vector3.new(0.18, 0.18, 3.4), steel, Enum.Material.SmoothPlastic)
    weld(stock, b1, CFrame.new(-0.11, 0.32, -2.6))
    local b2 = np("B2", Vector3.new(0.18, 0.18, 3.4), steel, Enum.Material.SmoothPlastic)
    weld(stock, b2, CFrame.new(0.11, 0.32, -2.6))
    local mz = np("Muzzle", Vector3.new(0.34, 0.34, 0.1), C.ink, Enum.Material.SmoothPlastic)
    weld(stock, mz, CFrame.new(0, 0.32, -4.32))
    local trig = np("Trigger", Vector3.new(0.07, 0.28, 0.1), steel, Enum.Material.Metal)
    weld(stock, trig, CFrame.new(0, -0.38, -0.45))
    gunTool.PrimaryPart = stock
    gunTool.Parent = LocalPlayer.Backpack
end

