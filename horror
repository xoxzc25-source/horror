local function pickShotTarget(origin, dir)
    local best, bestDist = nil, math.huge
    local function test(pos, radius, height, kind)
        if rayHitsCylinder(origin, dir, pos, radius, height) then
            local d = (pos - origin).Magnitude
            if d < bestDist then
                bestDist = d
                best = kind
            end
        end
    end
    if ST.monsterPos then
        test(ST.monsterPos, 4, 15, "monster")
    end
    if ST.brutePos then
        test(ST.brutePos, 4.5, 14, "brute")
    end
    if ST.stalkerPos and ST.stalkerState ~= "none" then
        test(ST.stalkerPos, 2.5, 7, "stalker")
    end
    if ST.crawlerState == "prowl" and ST.crawlerPos then
        test(ST.crawlerPos, 2.5, 3, "crawler")
    end
    for i, wc in ipairs(ST.waveCreatures) do
        if wc.model and wc.model.Parent then
            test(wc.pos, 2, 7, "wave_" .. i)
        end
    end
    return best
end

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("Лом") then
            local now = os.clock()
            if now - T.crowbarSwingT > 0.9 then
                T.crowbarSwingT = now
                playId(SOUNDS.crowbarHit, 0.9, false, math.random(90, 110) / 100)
                local r = root()
                if r then
                    local killed = false
                    if ST.stalkerPos and ST.stalkerState ~= "none" then
                        local d = (r.Position - ST.stalkerPos).Magnitude
                        if d < 6 then
                            playId(SOUNDS.crowbarHit, 1, false, 0.8)
                            destroyStalker()
                            killed = true
                            setStatusSafe("ЛОМ: стокер уничтожен", false)
                        end
                    end
                    if not killed and ST.crawlerState == "prowl" and ST.crawlerPos then
                        local d = (r.Position - ST.crawlerPos).Magnitude
                        if d < 6 then
                            playId(SOUNDS.crowbarHit, 1, false, 0.8)
                            destroyCrawler()
                            killed = true
                            setStatusSafe("ЛОМ: ползун уничтожен", false)
                        end
                    end
                    if not killed then
                        setStatusSafe("мимо · лом не берёт босса/Громилу/Мать", true)
                    end
                end
            end
        elseif char and char:FindFirstChild("Двухстволка") then
            if INV.loaded[1] or INV.loaded[2] then
                playId(SOUNDS.shot, 1, false)
                local muzzle = gunTool and gunTool:FindFirstChild("Muzzle")
                if muzzle then
                    local flash = part({ Size = Vector3.new(0.8, 0.8, 0.8),
                        Shape = Enum.PartType.Ball,
                        Color = Color3.fromRGB(255, 220, 120), Material = Enum.Material.Neon })
                    flash.CFrame = muzzle.CFrame
                    flash.Parent = workspace
                    local light = Instance.new("PointLight")
                    light.Color = Color3.fromRGB(255, 210, 120)
                    light.Range = 28
                    light.Brightness = 5
                    light.Parent = flash
                    task.delay(0.09, function() flash:Destroy() end)
                end
                ST.camShake = math.max(ST.camShake, 0.35)
                local r = root()
                if r then
                    r.AssemblyLinearVelocity -= camera.CFrame.LookVector * 14
                end
                if INV.loaded[1] then INV.loaded[1] = false
                elseif INV.loaded[2] then INV.loaded[2] = false end
                refreshInvUI()

                local origin = camera.CFrame.Position
                local dir = camera.CFrame.LookVector
                local target = pickShotTarget(origin, dir)

                if target == "monster" then
                    ST.monsterHP -= 1
                    ST.monsterHits += 1
                    ST.monsterStagger = os.clock() + 2
                    ST.monsterRage = math.min(4, ST.monsterRage + 1)
                    ST.rageStart = math.min(ST.rageStart,
                        os.clock() - (CFG.rageTimes[ST.monsterRage] or 0) - 1)
                    playId(SOUNDS.roar, 1, false, math.random(85, 105) / 100)
                    ST.camShake = 0.6
                    if monsterEyes then
                        for _, eye in ipairs(monsterEyes) do
                            eye.Color = Color3.fromRGB(255, 255, 255)
                            eye.Size = Vector3.one * 0.55
                        end
                    end
                    task.delay(2, function()
                        if monsterEyes then
                            for _, eye in ipairs(monsterEyes) do
                                eye.Color = C.blood
                                eye.Size = Vector3.one * 0.25
                            end
                        end
                    end)
                    if ST.monsterHP <= 0 then
                        print("[Nightfall] БОСС УБИТ")
                        destroyMonster()
                        ST.monsterPos = nil
                        jumpscare(0.6, true)
                        UI.winBack.Visible = true
                        UI.winBack.BackgroundTransparency = 1
                        tween(UI.winBack, 0.4, { BackgroundTransparency = 0.08 })
                        UI.winSub.Text = "но снаружи что-то проснулось..."
                        task.delay(6, function()
                            tween(UI.winBack, 0.5, { BackgroundTransparency = 1 })
                            task.delay(0.5, function()
                                UI.winBack.Visible = false
                                ST.waveStartDelay = os.clock() + 4
                            end)
                        end)
                    else
                        setStatusSafe("ПОПАДАНИЕ · " .. (6 - ST.monsterHP) .. "/6", true)
                    end
                elseif target == "brute" then
                    ST.bruteHP -= 1
                    playId(SOUNDS.roar, 0.9, false, 0.7)
                    ST.camShake = 0.5
                    if ST.bruteHP <= 0 then
                        destroyBrute()
                        setStatusSafe("ГРОМИЛА ПОВЕРЖЕН", false)
                    else
                        setStatusSafe("ГРОМИЛА · осталось: " .. ST.bruteHP, true)
                    end
                elseif target == "stalker" then
                    playId(SOUNDS.scream, 0.9, false, 1.2)
                    destroyStalker()
                    setStatusSafe("ВЫСТРЕЛ: стокер уничтожен", false)
                elseif target == "crawler" then
                    playId(SOUNDS.scream, 0.9, false, 1.35)
                    destroyCrawler()
                    setStatusSafe("ВЫСТРЕЛ: ползун уничтожен", false)
                elseif target and target:sub(1, 5) == "wave_" then
                    local idx = tonumber(target:sub(6))
                    local wc = ST.waveCreatures[idx]
                    if wc and wc.model and wc.model.Parent then
                        playId(SOUNDS.scream, 0.8, false, 1.25)
                        wc.model:Destroy()
                        ST.waveKills += 1
                        table.remove(ST.waveCreatures, idx)
                        setStatusSafe("ВЫСТРЕЛ: тварь волны уничтожена", false)
                    else
                        setStatusSafe("ПРОМАХ", true)
                    end
                else
                    setStatusSafe("ПРОМАХ", true)
                end
            else
                setStatusSafe("ПУСТО · V = перезарядка", true)
            end
        end
    end
    if input.KeyCode == Enum.KeyCode.F then
        setFlash(not ST.flashOn)
    elseif input.KeyCode == Enum.KeyCode.V then
        toggleReloadUI()
    elseif input.KeyCode == Enum.KeyCode.RightShift then
        local isOpen = UI.panel.Visible
        if isOpen then
            tween(UI.panel, 0.2, { GroupTransparency = 1 })
            tween(UI.panelScale, 0.2, { Scale = 0.94 })
            task.delay(0.2, function() UI.panel.Visible = false end)
            openBtn.Visible = true
        else
            UI.panel.Visible = true
            UI.panel.GroupTransparency = 1
            UI.panelScale.Scale = 0.94
            tween(UI.panel, 0.25, { GroupTransparency = 0 })
            tween(UI.panelScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
            openBtn.Visible = false
        end
    end
end)

