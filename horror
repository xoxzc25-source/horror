---------------------------------------------------------------- ГЛАВНЫЙ ЦИКЛ
local lastStaticTick = 0
local lastRadarUpdate = 0
local lastHeavyTick = 0

RunService.Heartbeat:Connect(function(dt)
    if ST.flashOn then
        flashPart.CFrame = camera.CFrame
    end
    if ST.camShake > 0 then
        ST.camShake = math.max(0, ST.camShake - dt * 1.2)
        camera.CFrame = camera.CFrame * CFrame.new(
            (math.random() - 0.5) * ST.camShake,
            (math.random() - 0.5) * ST.camShake, 0)
    end
    if not ST.running then
        UI.staticHolder.Visible = false
        if ST.staticSnd then ST.staticSnd.Volume = 0 end
        if ST.voicesSnd then ST.voicesSnd.Volume = 0 end
        return
    end

    local now = os.clock()
    local heavy = (now - lastHeavyTick) >= CFG.HEAVY_INTERVAL
    if heavy then lastHeavyTick = now end
    if now - lastRadarUpdate >= 0.35 then
        lastRadarUpdate = now
        updateRadar(now)
    end

    local ok, err = pcall(function()
        local r = root()
        if not r then return end
        local t = os.clock()
        local myPos = r.Position
        local camLook = camera.CFrame.LookVector
        local flatLook = Vector3.new(camLook.X, 0, camLook.Z)
        if flatLook.Magnitude > 0.01 then flatLook = flatLook.Unit end

        local h = myHum()
        if h then
            local bonus = (t < ST.adrenalineUntil) and 3 or 0
            local target = CFG.baseWalkSpeed + bonus
            if h.WalkSpeed ~= target then h.WalkSpeed = target end
        end

        -- ярость
        local elapsed = t - ST.rageStart
        local newRage = 0
        for i, rt in ipairs(CFG.rageTimes) do
            if elapsed >= rt then newRage = i end
        end
        if newRage > ST.monsterRage then
            ST.monsterRage = newRage
            ST.camShake = 0.5
            jumpscare(0.4, true)
            playId(SOUNDS.crypt, 0.8, false)
            setStatusSafe("ОНО ЗВЕРЕЕТ · стадия " .. ST.monsterRage .. "/4", true)
        end
        ST.scareChance = 0.4 + ST.monsterRage * 0.15

        -- МОНСТР
        if ST.monsterPos then
            local toMe = (myPos - ST.monsterPos) * Vector3.new(1, 0, 1)
            local dist = toMe.Magnitude
            local rageVis = ST.monsterRage / 4
            local speed = 4.5 * (1 + ST.monsterRage * 0.5)
            if ST.monsterRage == 4 then speed = 4.5 * 2.8 end

            local dotToM = 0
            if dist > 0.5 then
                dotToM = flatLook:Dot(toMe.Unit)
            end
            if ST.monsterAware and dotToM > 0.9 and dist < 50 then
                speed = speed * 0.45
            end
            if ST.monsterAware then speed = speed * 0.85 end
            if t < ST.monsterStagger then
                speed = 0
            end

            local targetPos = myPos
            if ST.monsterAware and dist > 12 then
                targetPos = myPos - flatLook * 10
                if dotToM < -0.3 then targetPos = myPos end
            end

            local toTarget = (targetPos - ST.monsterPos) * Vector3.new(1, 0, 1)
            local tDist = toTarget.Magnitude
            if tDist > 0.5 and speed > 0 then
                ST.monsterPos += toTarget.Unit * math.min(speed * dt, tDist)
            end
            if dist > 170 then
                local a = math.rad(math.random(0, 359))
                ST.monsterPos = myPos + Vector3.new(math.cos(a) * 90, 0, math.sin(a) * 90)
            end

            if heavy then
                local gy = groundAt(ST.monsterPos, myPos.Y)
                local base = CFrame.lookAt(
                    Vector3.new(ST.monsterPos.X, gy + CFG.MON_BASE_Y, ST.monsterPos.Z),
                    Vector3.new(myPos.X, gy + CFG.MON_BASE_Y, myPos.Z))
                local swayFreq = 1.7 + rageVis * 2.5
                local sway = math.sin(t * swayFreq) * (0.04 + rageVis * 0.06)
                local twitch = 0
                if math.floor(t * (2 + ST.monsterRage)) % 6 == 0 then
                    twitch = math.sin(t * (40 + ST.monsterRage * 20)) * (0.035 + rageVis * 0.05)
                end
                if t < ST.monsterStagger then
                    twitch = math.sin(t * 30) * 0.08
                    sway = math.sin(t * 12) * 0.1
                end
                local anim = CFrame.Angles(sway * 0.5, twitch, sway * 0.3)
                for _, e in ipairs(ST.monsterParts) do
                    e.p.CFrame = base * e.off * anim
                end
                if monsterEyes then
                    local pulse = 0.5 + 0.5 * math.sin(t * (3 + ST.monsterRage * 2))
                    for _, eye in ipairs(monsterEyes) do
                        eye.Color = C.blood:Lerp(Color3.fromRGB(255, 60, 60), pulse)
                        eye.Size = Vector3.one * (0.22 + pulse * 0.12 + rageVis * 0.08)
                    end
                end
            end

            local proximity = math.clamp(1 - dist / 130, 0, 1)
            if ST.voicesSnd and ST.voicesSnd.Parent then
                ST.voicesSnd.Volume = math.clamp(1 - dist / 220, 0, 1) * 0.5
            end
            if ST.staticSnd and ST.staticSnd.Parent then
                ST.staticSnd.Volume = math.clamp(1 - dist / 90, 0, 1) * 0.6
            end
            if heavy then
                local interference = math.clamp(proximity * (0.6 + rageVis * 0.4), 0, 1)
                setStaticIntensity(interference)
            end
            camera.FieldOfView = CFG.baseFOV + proximity * 5
                * math.abs(math.sin(t * (1.4 + proximity * 1.8) * math.pi))

            if t > ST.nextFar then
                ST.nextFar = t + math.random(8, 16) / (1 + ST.monsterRage * 0.3)
                playId(SOUNDS.far, 0.35 + proximity * 0.55, false, 0.85 + math.random() * 0.3)
            end
            if t > ST.nextScare then
                ST.nextScare = t + math.random(20, 45) / (0.4 + ST.scareChance)
                if math.random() < ST.scareChance then
                    jumpscare(0.3, ST.monsterRage >= 3)
                end
            end
            if ST.monsterHits >= 2 and t > ST.nextSummon then
                ST.nextSummon = t + math.random(18, 25)
                local which = math.random(1, 2)
                local a = math.rad(math.random(0, 359))
                playId(SOUNDS.crypt, 0.9, false, 0.7)
                ST.camShake = 0.3
                if which == 1 and not ST.stalker then
                    local p = myPos + Vector3.new(math.cos(a) * 25, 0, math.sin(a) * 25)
                    p = Vector3.new(p.X, groundAt(p, myPos.Y), p.Z)
                    ST.stalker = buildStalker(p)
                    ST.stalkerPos = p
                    ST.stalkerState = "follow"
                    ST.stalkerTimer = os.clock() + math.random(10, 16)
                    ST.stalkerLookTime = 0
                    ST.stalkerWalkPhase = 0
                    setStatusSafe("ОНО ЗОВЁТ СВОИХ...", true)
                elseif which == 2 and not ST.crawler then
                    local p = myPos + Vector3.new(math.cos(a) * 40, 0, math.sin(a) * 40)
                    p = Vector3.new(p.X, groundAt(p, myPos.Y), p.Z)
                    ST.crawler = buildCrawler(p)
                    ST.crawlerPos = p
                    ST.crawlerState = "prowl"
                    ST.crawlerWalkPhase = 0
                    setStatusSafe("ОНО ЗОВЁТ СВОИХ... шорох", true)
                end
            end
            if dist < 6.5 and t > ST.monsterStagger then
                jumpscare(1, true)
                ST.running = false
                task.delay(1.1, function()
                    stopRitualSafe(true)
                    deadBack.Visible = true
                    deadBack.BackgroundTransparency = 1
                    tween(deadBack, 0.4, { BackgroundTransparency = 0.08 })
                    setStatusSafe("ты пойман", true)
                end)
                return
            end
        end

        -- ГРОМИЛА
        if not ST.waveActive and not ST.brute and ST.monsterPos
            and (t - ST.rageStart > 120 or ST.monsterHits >= 3) then
            local a = math.rad(math.random(0, 359))
            local p = myPos + Vector3.new(math.cos(a) * 60, 0, math.sin(a) * 60)
            p = Vector3.new(p.X, groundAt(p, myPos.Y), p.Z)
            ST.brute = buildBrute(p)
            ST.brutePos = p
            ST.bruteHP = 3
            ST.bruteWalkPhase = 0
            setStatusSafe("ЗЕМЛЯ ДРОЖИТ. ГРОМИЛА ИДЁТ. 3 патрона.", true)
            playId(SOUNDS.roar, 0.9, false, 0.7)
        end
        if ST.brutePos and ST.brute and not ST.waveActive then
            local toMe = myPos - ST.brutePos
            local flat = Vector3.new(toMe.X, 0, toMe.Z)
            local dist = flat.Magnitude
            local moving = dist > 6
            if moving and dist > 1 then
                ST.brutePos += flat.Unit * math.min(3.5 * dt, dist)
                ST.bruteWalkPhase += dt * 3.2
            end
            if heavy then
                local gy = groundAt(ST.brutePos, myPos.Y)
                local base = CFrame.lookAt(
                    Vector3.new(ST.brutePos.X, gy, ST.brutePos.Z),
                    Vector3.new(myPos.X, gy, myPos.Z))
                local swing = moving and math.sin(ST.bruteWalkPhase) * 0.35 or 0
                local idx = 0
                for _, e in ipairs(ST.bruteParts) do
                    idx += 1
                    if idx >= 6 and idx <= 9 then
                        e.p.CFrame = base * e.off
                            * CFrame.Angles(swing * (idx % 2 == 0 and 1 or -1), 0, 0)
                    elseif idx >= 10 then
                        e.p.CFrame = base * e.off
                            * CFrame.Angles(-swing * (idx % 2 == 0 and 1 or -1), 0, 0)
                    else
                        e.p.CFrame = base * e.off
                    end
                end
            end
            if dist < 7 then
                if t > ST.bruteNext then
                    ST.bruteNext = t + 2
                    applyDamage(30)
                    ST.camShake = 0.6
                    playId(SOUNDS.roar, 0.8, false, 0.8)
                end
            end
        end

        -- ВОЛНА
        if ST.waveStartDelay > 0 and t > ST.waveStartDelay then
            ST.waveStartDelay = 0
            ST.waveActive = true
            ST.waveNextSpawn = 0
            setStatusSafe("ВОЛНА. УБЕЙ ВСЕХ — И ТЫ ПЕРЕЖИВЁШЬ.", true)
            playId(SOUNDS.roar, 1, false)
            ST.camShake = 0.6
            destroyStalker()
            destroyCrawler()
            destroyMother()
            destroyWatcher()
            destroyBrute()
        end
        if ST.waveActive then
            if #ST.waveCreatures < 14 and t > ST.waveNextSpawn then
                ST.waveNextSpawn = t + math.random(2, 4)
                for _ = 1, math.random(2, 3) do
                    local a = math.rad(math.random(0, 359))
                    local pos = myPos + Vector3.new(math.cos(a) * 300, 0, math.sin(a) * 300)
                    pos = Vector3.new(pos.X, groundAt(pos, myPos.Y), pos.Z)
                    local w = Instance.new("Model")
                    w.Name = "NF_Wave"
                    local skin = Color3.fromRGB(15, 12, 14)
                    local plist = {}
                    local function wp(props, off)
                        local p = part(props)
                        p.Parent = w
                        table.insert(plist, { p = p, off = off })
                        return p
                    end
                    wp({ Size = Vector3.new(2, 5, 1.2), Color = skin, Material = Enum.Material.Slate },
                        CFrame.new(0, 2.5, 0))
                    wp({ Size = Vector3.new(1.2, 1.4, 1.2), Color = skin,
                        Material = Enum.Material.Slate }, CFrame.new(0, 5.7, 0))
                    wp({ Size = Vector3.new(0.16, 0.16, 0.16), Shape = Enum.PartType.Ball,
                        Color = C.blood, Material = Enum.Material.Neon }, CFrame.new(-0.28, 5.8, -0.6))
                    wp({ Size = Vector3.new(0.16, 0.16, 0.16), Shape = Enum.PartType.Ball,
                        Color = C.blood, Material = Enum.Material.Neon }, CFrame.new(0.28, 5.8, -0.6))
                    wp({ Size = Vector3.new(0.5, 4.4, 0.5), Color = skin, Material = Enum.Material.Slate },
                        CFrame.new(-1.25, 2.6, 0))
                    wp({ Size = Vector3.new(0.5, 4.4, 0.5), Color = skin, Material = Enum.Material.Slate },
                        CFrame.new(1.25, 2.6, 0))
                    wp({ Size = Vector3.new(0.6, 2.4, 0.6), Color = skin, Material = Enum.Material.Slate },
                        CFrame.new(-0.5, 1.2, 0))
                    wp({ Size = Vector3.new(0.6, 2.4, 0.6), Color = skin, Material = Enum.Material.Slate },
                        CFrame.new(0.5, 1.2, 0))
                    w.PrimaryPart = plist[1].p
                    w:PivotTo(CFrame.lookAt(pos, myPos))
                    w.Parent = workspace
                    table.insert(ST.waveCreatures, {
                        model = w, plist = plist, pos = pos,
                        speed = math.random(11, 16),
                    })
                end
            end
            local nearest = nil
            local alive = {}
            for _, wc in ipairs(ST.waveCreatures) do
                if wc.model and wc.model.Parent then
                    local cPos = wc.pos
                    local toMe = myPos - cPos
                    local flat = Vector3.new(toMe.X, 0, toMe.Z)
                    local d = flat.Magnitude
                    if d > 1 then
                        cPos += flat.Unit * math.min(wc.speed * dt, d)
                    end
                    wc.pos = cPos
                    if heavy then
                        local gy = groundAt(cPos, myPos.Y)
                        local base = CFrame.lookAt(
                            Vector3.new(cPos.X, gy, cPos.Z),
                            Vector3.new(myPos.X, gy, myPos.Z))
                        local swing = math.sin(t * 8 + wc.speed) * 0.4
                        for _, pe in ipairs(wc.plist) do
                            if pe.off.Position.Y > 4 then
                                pe.p.CFrame = base * pe.off
                                    * CFrame.Angles(swing * (pe.off.Position.X < 0 and 1 or -1), 0, 0)
                            else
                                pe.p.CFrame = base * pe.off
                            end
                        end
                    end
                    if d < 4 then
                        applyDamage(10)
                        wc.model:Destroy()
                    else
                        table.insert(alive, wc)
                        if not nearest or d < nearest then nearest = d end
                    end
                end
            end
            ST.waveCreatures = alive
            ST.waveNearest = nearest
            if #ST.waveCreatures == 0 and t > ST.waveNextSpawn and ST.waveKills >= 3 then
                ST.running = false
                ST.waveActive = false
                stopRitualSafe(true)
                UI.winBack.Visible = true
                UI.winBack.BackgroundTransparency = 1
                tween(UI.winBack, 0.6, { BackgroundTransparency = 0.05 })
                UI.winSub.Text = "рассвет близко..."
                tween(UI.survivedLbl, 1, { TextTransparency = 0 })
                playId(SOUNDS.ambient, 0.5, false, 1.1)
            end
        end

        -- СТОКЕР
        if ST.stalkerPos and ST.stalkerState ~= "none" and not ST.waveActive then
            if ST.stalkerState == "follow" then
                local target = myPos - flatLook * 22
                local toT = target - ST.stalkerPos
                toT = Vector3.new(toT.X, 0, toT.Z)
                local d = toT.Magnitude
                if d > 0.5 then
                    ST.stalkerPos += toT.Unit * math.min(10.5 * dt, d)
                    ST.stalkerWalkPhase += dt * 6
                end
                if d > 70 then
                    ST.stalkerPos = myPos - flatLook * 26
                end
                local toS = ST.stalkerPos - myPos
                local looking = toS.Magnitude > 0.5
                    and flatLook:Dot(Vector3.new(toS.X, 0, toS.Z).Unit) > 0.6
                    and toS.Magnitude < 60
                if looking then
                    ST.stalkerLookTime += dt
                    if ST.stalkerLookTime > 1.2 then
                        ST.stalkerState = "charge"
                        ST.stalkerLookTime = 0
                        ST.camShake = 0.4
                        setStatusSafe("ОНО ПОБЕЖАЛО. БЕГИ.", true)
                    end
                else
                    ST.stalkerLookTime = math.max(0, ST.stalkerLookTime - dt)
                end
                if t > ST.stalkerTimer then
                    ST.stalkerState = "charge"
                    ST.camShake = 0.4
                    setStatusSafe("ОНО БЕЖИТ. БЕГИ.", true)
                end
            elseif ST.stalkerState == "charge" then
                local toMe = myPos - ST.stalkerPos
                toMe = Vector3.new(toMe.X, 0, toMe.Z)
                local d = toMe.Magnitude
                if d > 0.5 then
                    ST.stalkerPos += toMe.Unit * math.min(26 * dt, d)
                    ST.stalkerWalkPhase += dt * 11
                end
                ST.camShake = math.max(ST.camShake, 0.15)
                if d < 4 then
                    applyDamage(15)
                    destroyStalker()
                    setStatusSafe("оно ударило и исчезло...", true)
                end
            end
            if heavy and ST.stalker and ST.stalker.Parent then
                local moving = (ST.stalkerState == "charge")
                local gy = groundAt(ST.stalkerPos, myPos.Y)
                local base = CFrame.lookAt(
                    Vector3.new(ST.stalkerPos.X, gy, ST.stalkerPos.Z),
                    Vector3.new(myPos.X, gy, myPos.Z))
                local speed = moving and 11 or 6
                local swing = math.sin(ST.stalkerWalkPhase) * (moving and 0.9 or 0.55)
                for _, e in ipairs(ST.stalkerParts) do
                    if e.half == 0 then
                        e.p.CFrame = base * e.pivot
                    else
                        e.p.CFrame = base * e.pivot
                            * CFrame.Angles(swing * e.sign, 0, 0)
                            * CFrame.new(0, -e.half, 0)
                    end
                end
            end
        end

        -- ПОЛЗУН
        if ST.crawlerState == "prowl" and ST.crawler then
            local toMe = myPos - ST.crawlerPos
            local flat = Vector3.new(toMe.X, 0, toMe.Z)
            local dist = flat.Magnitude
            local dirToC = ST.crawlerPos - myPos
            local seen = dist > 0.5
                and flatLook:Dot(Vector3.new(dirToC.X, 0, dirToC.Z).Unit) > 0.5
                and dist < 60

            local spd = seen and 2 or (dist > 25 and 9 or 4.5)
            if dist > 0.5 then
                ST.crawlerPos += flat.Unit * math.min(spd * dt, dist)
                ST.crawlerWalkPhase += dt * spd * 1.8
            end

            if dist < 3.5 then
                applyDamage(12)
                jumpscare(0.35)
                destroyCrawler()
                task.delay(math.random(15, 25), function()
                    if not ST.running then return end
                    local rr = root()
                    if not rr then return end
                    local a = math.rad(math.random(0, 359))
                    local p = rr.Position + Vector3.new(math.cos(a) * 40, 0, math.sin(a) * 40)
                    p = Vector3.new(p.X, groundAt(p, rr.Position.Y), p.Z)
                    ST.crawler = buildCrawler(p)
                    ST.crawlerPos = p
                    ST.crawlerState = "prowl"
                    ST.crawlerWalkPhase = 0
                    setStatusSafe("шорох снова...", true)
                end)
            else
                if heavy then
                    local gy = groundAt(ST.crawlerPos, myPos.Y)
                    local base = CFrame.lookAt(
                        Vector3.new(ST.crawlerPos.X, gy + 0.6, ST.crawlerPos.Z),
                        Vector3.new(myPos.X, gy + 0.6, myPos.Z))
                    local partsByName = {}
                    for _, e in ipairs(ST.crawlerParts) do
                        partsByName[e.name] = e
                    end
                    local crawlWave = math.sin(ST.crawlerWalkPhase * 2) * 0.12
                    local bob = math.abs(math.sin(ST.crawlerWalkPhase)) * 0.2
                    local roll = math.sin(ST.crawlerWalkPhase) * 0.12
                    for _, e in ipairs(ST.crawlerParts) do
                        if e.name == "torso" then
                            e.p.CFrame = base * e.off
                                * CFrame.new(0, bob, 0)
                                * CFrame.Angles(crawlWave, 0, roll)
                        elseif e.name:sub(1, 3) == "rib" then
                            local ribN = tonumber(e.name:sub(4))
                            e.p.CFrame = base * e.off
                                * CFrame.new(0, bob, 0)
                                * CFrame.Angles(crawlWave, 0, roll)
                                * CFrame.Angles(0, 0, math.sin(ST.crawlerWalkPhase * 2 + ribN) * 0.15)
                        end
                    end
                    local twitchHead = (math.floor(t * 4) % 3 == 0)
                        and math.sin(t * 60) * 0.06 or 0
                    local headNod = math.sin(ST.crawlerWalkPhase * 2) * 0.12
                    if partsByName.head then
                        partsByName.head.p.CFrame = base * partsByName.head.off
                            * CFrame.new(0, bob, 0)
                            * CFrame.Angles(headNod + twitchHead, twitchHead, roll)
                    end
                    local jawDrop = math.abs(math.sin(t * 6)) * 0.25
                    if partsByName.jaw then
                        partsByName.jaw.p.CFrame = base * partsByName.jaw.off
                            * CFrame.new(0, bob, 0)
                            * CFrame.Angles(math.rad(45) + jawDrop + headNod, 0, roll)
                    end
                    for _, nm in ipairs({ "eyeL", "eyeR", "mouth" }) do
                        if partsByName[nm] then
                            partsByName[nm].p.CFrame = base * partsByName[nm].off
                                * CFrame.new(0, bob, 0) * CFrame.Angles(headNod, twitchHead, roll)
                        end
                    end
                    local limbSwing = math.sin(ST.crawlerWalkPhase) * 0.55
                    if partsByName.armL then
                        partsByName.armL.p.CFrame = base * partsByName.armL.off
                            * CFrame.Angles(limbSwing, 0, 0)
                            * CFrame.new(0, -partsByName.armL.p.Size.Y / 2, -limbSwing * 0.4)
                    end
                    if partsByName.armR then
                        partsByName.armR.p.CFrame = base * partsByName.armR.off
                            * CFrame.Angles(-limbSwing, 0, 0)
                            * CFrame.new(0, -partsByName.armR.p.Size.Y / 2, limbSwing * 0.4)
                    end
                    if partsByName.legL then
                        partsByName.legL.p.CFrame = base * partsByName.legL.off
                            * CFrame.Angles(-limbSwing, 0, 0)
                            * CFrame.new(0, -partsByName.legL.p.Size.Y / 2, limbSwing * 0.4)
                    end
                    if partsByName.legR then
                        partsByName.legR.p.CFrame = base * partsByName.legR.off
                            * CFrame.Angles(limbSwing, 0, 0)
                            * CFrame.new(0, -partsByName.legR.p.Size.Y / 2, -limbSwing * 0.4)
                    end
                end
            end
        end

        -- МАТЬ
        if not ST.waveActive and not ST.mother and ST.monsterPos and t - ST.rageStart > 70 then
            local a = math.rad(math.random(0, 359))
            local p = myPos + Vector3.new(math.cos(a) * 35, 0, math.sin(a) * 35)
            p = Vector3.new(p.X, groundAt(p, myPos.Y), p.Z)
            ST.mother = buildMother(p)
            ST.motherPos = p
            ST.motherNext = t + 1.5
            ST.motherTilt = 0
            setStatusSafe("ОНА ЗДЕСЬ. НЕ ОТВОДИ ВЗГЛЯД.", true)
        end
        if ST.motherPos and ST.mother and not ST.waveActive then
            local toMe = myPos - ST.motherPos
            local flat = Vector3.new(toMe.X, 0, toMe.Z)
            local dist = flat.Magnitude
            local dirToM = ST.motherPos - myPos
            local seen = dist > 0.5
                and flatLook:Dot(Vector3.new(dirToM.X, 0, dirToM.Z).Unit) > 0.25
                and dist < 120
            if not seen and t > ST.motherNext then
                ST.motherNext = t + math.random(0.8, 2)
                if dist > 5 then
                    local step = math.random(6, 10)
                    local jitter = Vector3.new(math.random(-4, 4), 0, math.random(-4, 4))
                    ST.motherPos = ST.motherPos + flat.Unit * math.min(step, dist - 2) + jitter
                    ST.motherPos = Vector3.new(ST.motherPos.X,
                        groundAt(ST.motherPos, myPos.Y), ST.motherPos.Z)
                    ST.motherTilt = (ST.motherTilt + math.random(20, 45)) % 180
                    setStaticIntensity(0.85)
                    playId(SOUNDS.static, 0.5, false, math.random(70, 130) / 100)
                    ST.camShake = math.max(ST.camShake, 0.25)
                    task.delay(0.15, function() setStaticIntensity(0) end)
                end
            end
            if dist < 10 and dist > 0.1 then
                if not ST.mother:GetAttribute("grind") or t - ST.mother:GetAttribute("grind") > 1 then
                    ST.mother:SetAttribute("grind", t)
                    playId(SOUNDS.static, 0.4, false, 0.5)
                end
            end
            if dist < 5 then
                applyDamage(25)
                jumpscare(0.5, true)
                destroyMother()
                task.delay(math.random(25, 40), function()
                    if not ST.running then return end
                    local rr = root()
                    if not rr then return end
                    local a = math.rad(math.random(0, 359))
                    local p = rr.Position + Vector3.new(math.cos(a) * 35, 0, math.sin(a) * 35)
                    p = Vector3.new(p.X, groundAt(p, rr.Position.Y), p.Z)
                    ST.mother = buildMother(p)
                    ST.motherPos = p
                    ST.motherTilt = 0
                end)
            end
            if heavy and ST.mother and ST.mother.Parent then
                local gy = groundAt(ST.motherPos, myPos.Y)
                local base = CFrame.lookAt(
                    Vector3.new(ST.motherPos.X, gy, ST.motherPos.Z),
                    Vector3.new(myPos.X, gy, myPos.Z))
                    * CFrame.Angles(0, 0, math.rad(ST.motherTilt))
                for _, e in ipairs(ST.motherParts) do
                    e.p.CFrame = base * e.off
                end
            end
        end

        -- СИЛУЭТ
        if ST.watcherAlive and ST.watcher then
            local wPos = ST.watcher:GetPivot().Position
            local flat = Vector3.new(myPos.X, wPos.Y, myPos.Z)
            local wDist = (myPos - wPos).Magnitude
            local lookW = CFrame.lookAt(Vector3.new(wPos.X, wPos.Y, wPos.Z), flat)
            for _, e in ipairs(ST.watcherParts) do
                e.p.CFrame = lookW * e.off
            end
            if wDist < 12 then
                for _, e in ipairs(ST.watcherParts) do
                    local pe = Instance.new("ParticleEmitter")
                    pe.Rate = 120
                    pe.Lifetime = NumberRange.new(0.5, 1)
                    pe.Speed = NumberRange.new(2, 5)
                    pe.Size = NumberSequence.new(0.3)
                    pe.Color = ColorSequence.new(Color3.fromRGB(15, 15, 18))
                    pe.Transparency = NumberSequence.new(0.3)
                    pe.Parent = e.p
                end
                ST.camShake = 0.2
                local w = ST.watcher
                ST.watcherAlive = false
                ST.watcher = nil
                task.delay(1.4, function() w:Destroy() end)
                task.delay(math.random(20, 40), function()
                    if not ST.running then return end
                    local rr = root()
                    if not rr then return end
                    local a = math.rad(math.random(0, 359))
                    ST.watcher = buildWatcher(rr.Position + Vector3.new(math.cos(a) * 60, 0, math.sin(a) * 60))
                    ST.watcherAlive = true
                end)
            end
        end

        if t > ST.nextBehind and not ST.waveActive then
            ST.nextBehind = t + math.random(40, 90)
            flashBehindEvent()
            local p = myPos - flatLook * 7
            p = Vector3.new(p.X, groundAt(p, myPos.Y), p.Z)
            local gw = buildWatcher(p)
            task.delay(2.5, function() if gw then gw:Destroy() end end)
        end
        if t > ST.nextFlicker then
            ST.nextFlicker = t + math.random(25, 60)
            task.spawn(function()
                for _ = 1, 6 do
                    Lighting.Brightness = math.random(1, 10) / 10
                    if ST.flashOn then spot.Enabled = math.random() > 0.5 end
                    task.wait(0.07)
                end
                Lighting.Brightness = 0.8
                if ST.flashOn then spot.Enabled = true end
            end)
            playId(SOUNDS.voices, 0.2, false, 1.15)
        end
    end)

    if not ok and not ST.warnedOnce then
        ST.warnedOnce = true
        warn("[Nightfall] ошибка цикла:", err)
    end
end)

