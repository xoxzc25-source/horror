local hurtLbl = New("TextLabel", {
    Text = "", Font = F.black, TextSize = 60, TextColor3 = C.blood,
    BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5),
    Position = UDim2.new(0.5, 0, 0.45, 0), Size = UDim2.fromOffset(300, 70),
    TextTransparency = 1, Parent = hurtGui,
})
local function applyDamage(amount)
    local h = myHum()
    if not h then return end
    h.Health = math.max(0, h.Health - amount)
    hurtLbl.Text = "-" .. tostring(amount)
    hurtFrame.BackgroundTransparency = 1
    tween(hurtFrame, 0.12, { BackgroundTransparency = 0.45 })
    tween(hurtLbl, 0.12, { TextTransparency = 0 })
    camShake = math.max(camShake, 0.35)
    task.delay(0.35, function()
        tween(hurtFrame, 0.9, { BackgroundTransparency = 1 })
        tween(hurtLbl, 0.6, { TextTransparency = 1 })
    end)
    if h.Health <= 0 then
        running = false
        task.delay(0.6, function()
            stopRitualSafe(true)
            deadBack.Visible = true
            deadBack.BackgroundTransparency = 1
            tween(deadBack, 0.4, { BackgroundTransparency = 0.08 })
        end)
    end
end

